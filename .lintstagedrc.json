{
  "**/*.{json,jsonc}": "eslint --fix",
  "apps/**/wizard/*": "eslint --no-warn-ignored",
  "apps/**/app/ui/config": "eslint --no-warn-ignored",
  "apps/**/app/**/*.{js,mjs,cjs}": "eslint --no-warn-ignored --fix",
