{
  "name": "fn-os-apps",
  "version": "5.1.2",
  "private": true,
  "description": "飞牛 fnOS 应用 Monorepo",
  "scripts": {
    "bump": "./bump",
    "bump:major": "./bump major",
    "bump:minor": "./bump minor",
    "bump:patch": "./bump patch",
    "lint:shell": "rg -l -0 --hidden --glob '!.git/**' --glob '!node_modules/**' --glob '!apps/fn-nvm/app/nvm/install.sh' '^#!.*(?:bash|sh)' . | xargs -0 shfmt -d -i 4",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:sdd": "node scripts/sdd/check-docs.mjs",
    "check:docs": "pnpm run check:sdd && pnpm run docs:build",
    "check:packages": "pnpm --filter './packages/*' run check",
    "check:plugins": "pnpm --filter './plugins/*' run check",
    "build:fnos-gateway": "pnpm --filter @tnnevol/fnos-gateway run build:app",
    "check": "pnpm run check:sdd && pnpm run docs:build && pnpm run check:packages && pnpm run check:plugins"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.16.0"
  },
  "packageManager": "pnpm@11.16.0",
  "devDependencies": {
    "@miletorix/vitepress-image-viewer": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-d2": "catalog:"
  }
}
