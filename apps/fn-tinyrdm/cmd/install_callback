#!/bin/bash

### This script is called after the user installs the application.

# 数据目录首次安装时不存在，先建出来，避免 Docker 以 root 建出属主错误的目录。
# nginx 的日志与临时目录改用 tmpfs 提供（见 compose），不在这里处理：
# 容器由应用中心在回调之前创建，靠回调建宿主目录来不及。
if [ -z "${TRIM_PKGVAR}" ]; then
    echo "TRIM_PKGVAR is not set; cannot prepare application data directory" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

mkdir -p "${TRIM_PKGVAR}/data"

chown -R "${TRIM_USERNAME:-${TRIM_UID}}:${TRIM_GROUPNAME:-${TRIM_GID}}" "${TRIM_PKGVAR}/data" 2>/dev/null || true
chmod -R 775 "${TRIM_PKGVAR}/data" 2>/dev/null || true

echo "Prepared Tiny RDM data directory: ${TRIM_PKGVAR}/data"

exit 0
