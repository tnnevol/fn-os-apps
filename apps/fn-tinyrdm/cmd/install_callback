#!/bin/bash

### This script is called after the user installs the application.

# 容器以包用户运行（见 compose 的 user:），nginx 需要可写的日志与临时目录。
# 这两个目录在 compose 里改为挂载宿主路径，必须先存在且属主正确，
# 否则 Docker 会以 root 建出来，nginx 仍然写不进去。
if [ -z "${TRIM_PKGVAR}" ]; then
    echo "TRIM_PKGVAR is not set; cannot prepare application data directory" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

mkdir -p "${TRIM_PKGVAR}/data"
mkdir -p "${TRIM_PKGVAR}/nginx/logs"
mkdir -p "${TRIM_PKGVAR}/nginx/tmp"

# 包用户自己建的目录属主已正确；仅在有权限时兜底对齐一次。
chown -R "${TRIM_USERNAME:-${TRIM_UID}}:${TRIM_GROUPNAME:-${TRIM_GID}}" \
    "${TRIM_PKGVAR}/data" "${TRIM_PKGVAR}/nginx" 2>/dev/null || true
chmod -R 775 "${TRIM_PKGVAR}/data" "${TRIM_PKGVAR}/nginx" 2>/dev/null || true

if touch "${TRIM_PKGVAR}/nginx/logs/.write_check" 2>/dev/null; then
    rm -f "${TRIM_PKGVAR}/nginx/logs/.write_check"
    echo "Prepared Tiny RDM data and nginx runtime directories: ${TRIM_PKGVAR}"
else
    echo "Tiny RDM nginx log directory is not writable: ${TRIM_PKGVAR}/nginx/logs" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

exit 0
