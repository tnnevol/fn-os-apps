#!/bin/bash

COMPOSE_DIR="$(dirname "${TRIM_APPDEST}/docker/docker-compose.yaml")"

# 绑定挂载的宿主目录必须**在容器创建之前**存在。
# install_callback 在容器创建之后才执行，靠它建目录来不及：Docker 会先把不存在的
# 挂载源以 root 建出来，容器内的包用户随即写不进去（nginx 起不来的真因）。
# 因此在拉起容器前自己兜一次。
ensure_mount_dirs() {
    [ -n "${TRIM_PKGVAR}" ] || return 0
    mkdir -p "${TRIM_PKGVAR}/data" \
        "${TRIM_PKGVAR}/nginx/logs" \
        "${TRIM_PKGVAR}/nginx/tmp" 2>/dev/null || true
}

# 检查 compose 项目下是否有 running 状态的容器
is_docker_running() {
    local RUNNING
    RUNNING=$(docker compose -p "$TRIM_APPNAME" ps --format '{{.State}}' 2>/dev/null | grep -ci 'running')
    echo "[DEBUG] is_docker_running: $RUNNING running container(s)"
    [ "$RUNNING" -gt 0 ]
}

# 确保 compose 中容器已创建并启动
ensure_containers_created() {
    cd "$COMPOSE_DIR" || return 1
    local EXISTS
    EXISTS=$(docker compose -p "$TRIM_APPNAME" ps -a --format '{{.Name}}' 2>/dev/null | wc -l)
    if [ "$EXISTS" -gt 0 ]; then
        echo "[DEBUG] ensure_containers_created: all containers already exist"
        return 0
    fi

    echo "[DEBUG] running: docker compose -p $TRIM_APPNAME up -d"
    ensure_mount_dirs
    docker compose -p "$TRIM_APPNAME" up -d 2>&1
    if [ $? -ne 0 ]; then
        echo "[DEBUG] docker compose up -d FAILED"
        echo "Docker compose 创建容器失败" >"${TRIM_TEMP_LOGFILE}"
        return 1
    fi
    echo "[DEBUG] docker compose up -d OK"
    return 0
}

case $1 in
start)
    echo "[DEBUG] cmd/main called with action: $1"
    exit 0
    ;;
stop)
    echo "[DEBUG] cmd/main called with action: $1"
    # do nothing, docker application will be stopped by appcenter
    exit 0
    ;;
status)
    echo "[DEBUG] cmd/main called with action: $1"
    # 容器缺失时创建容器，创建失败则返回 exit 1
    if ! ensure_containers_created; then
        exit 1
    fi
    if is_docker_running; then
        echo "[DEBUG] container is running"
        exit 0
    else
        echo "[DEBUG] container is NOT running"
        exit 3
    fi
    ;;
*)
    echo "[DEBUG] cmd/main called with unknown action: $1"
    exit 1
    ;;
esac
