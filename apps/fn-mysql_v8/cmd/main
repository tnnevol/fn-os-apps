#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/mysqld.pid"
SOCKET_FILE="${TRIM_PKGVAR}/mysql.sock"

MYSQLD="${TRIM_APPDEST}/server/usr/sbin/mysqld"
MYSQL_CLIENT="${TRIM_APPDEST}/server/usr/bin/mysql"
MYSQLADMIN="${TRIM_APPDEST}/server/usr/bin/mysqladmin"
DATADIR="${TRIM_PKGHOME}/data"
CNF_FILE="${TRIM_PKGETC}/my.cnf"
MYSQL_PORT="${APP_PORT:-3306}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

user_error() {
    echo "$1" > "${TRIM_TEMP_LOGFILE}"
    log_msg "USER ERROR: $1"
}

start_process() {
    if status; then
        log_msg "MySQL is already running"
        return 0
    fi

    log_msg "Starting MySQL v8 on port ${MYSQL_PORT} ..."

    # Pre-flight checks
    if [ ! -x "${MYSQLD}" ]; then
        user_error "MySQL 服务程序未找到，请重新安装应用。"
        return 1
    fi

    if [ ! -d "${DATADIR}/mysql" ]; then
        user_error "MySQL 数据库未初始化，安装过程可能未成功完成，请尝试卸载后重新安装。"
        return 1
    fi

    if [ ! -f "${CNF_FILE}" ]; then
        user_error "MySQL 配置文件丢失，请尝试卸载后重新安装。"
        return 1
    fi

    # Ensure runtime directory exists
    mkdir -p "${TRIM_PKGVAR}/run"

    # Start mysqld (script runs as root; --user in my.cnf or cmd drops privileges)
    "${MYSQLD}" \
        --defaults-file="${CNF_FILE}" \
        --port="${MYSQL_PORT}" \
        --user="${TRIM_USERNAME}" \
        >> "${LOG_FILE}" 2>&1 &
    local mysqld_pid=$!
    printf "%s" "${mysqld_pid}" > "${PID_FILE}"
    log_msg "mysqld started with PID=${mysqld_pid}, port=${MYSQL_PORT}"

    # Wait up to 30 seconds for MySQL to become ready
    local count=0
    while [ $count -lt 30 ]; do
        sleep 1
        count=$((count + 1))

        # Check if process is still alive
        if ! kill -0 "${mysqld_pid}" 2>/dev/null; then
            user_error "MySQL 启动失败，请查看应用日志了解详情。"
            rm -f "${PID_FILE}"
            return 1
        fi

        # Try to connect via socket (as root through sudo to app user)
        if sudo -u "${TRIM_USERNAME}" "${MYSQL_CLIENT}" \
            --socket="${SOCKET_FILE}" -u root \
            -e "SELECT 1" >/dev/null 2>&1; then
            log_msg "MySQL is ready after ${count}s"
            return 0
        fi
    done

    # Timeout
    user_error "MySQL 启动超时（30秒），请检查端口 ${MYSQL_PORT} 是否被占用，或查看应用日志。"
    kill -TERM "${mysqld_pid}" 2>/dev/null
    rm -f "${PID_FILE}"
    return 1
}

stop_process() {
    log_msg "Stopping MySQL ..."

    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if kill -0 "${pid}" 2>/dev/null; then
            # Graceful shutdown via mysqladmin
            if [ -n "${MYSQL_ROOT_PASSWORD}" ] && \
               [ -f "${TRIM_PKGETC}/.root_password_set" ]; then
                sudo -u "${TRIM_USERNAME}" "${MYSQLADMIN}" \
                    --socket="${SOCKET_FILE}" \
                    -u root -p"${MYSQL_ROOT_PASSWORD}" \
                    shutdown >> "${LOG_FILE}" 2>&1
            else
                sudo -u "${TRIM_USERNAME}" "${MYSQLADMIN}" \
                    --socket="${SOCKET_FILE}" \
                    -u root \
                    shutdown >> "${LOG_FILE}" 2>&1
            fi
        fi
    fi

    # Wait up to 30 seconds for graceful shutdown
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        local count=0
        while kill -0 "${pid}" 2>/dev/null && [ $count -lt 30 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "Waiting for MySQL to stop... (${count}s/30s)"
        done

        # Force kill if still running
        if kill -0 "${pid}" 2>/dev/null; then
            log_msg "MySQL did not stop gracefully, sending SIGKILL ..."
            kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
            sleep 2
        fi
        rm -f "${PID_FILE}"
    fi

    log_msg "MySQL stopped"
    return 0
}

status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if kill -0 "${pid}" 2>/dev/null; then
            return 0
        else
            # Stale PID file
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
