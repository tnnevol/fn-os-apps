#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
SOCKET_FILE="${TRIM_PKGVAR}/mysql.sock"

MYSQLD="${TRIM_APPDEST}/server/usr/sbin/mysqld"
MYSQL_CLIENT="${TRIM_APPDEST}/server/usr/bin/mysql"
MYSQLADMIN="${TRIM_APPDEST}/server/usr/bin/mysqladmin"
DATADIR="${TRIM_PKGHOME}/data"
CNF_FILE="${TRIM_PKGETC}/mysql.cnf"
MYSQL_PORT="${APP_PORT:-3306}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

user_error() {
    echo "$1" > "${TRIM_TEMP_LOGFILE}"
    log_msg "USER ERROR: $1"
}

start_process() {
    if status; then
        log_msg "MySQL is already running"
        return 0
    fi

    log_msg "Starting MySQL v8 on port ${MYSQL_PORT} ..."

    # Pre-flight checks
    if [ ! -x "${MYSQLD}" ]; then
        user_error "MySQL 服务程序未找到，请重新安装应用。"
        return 1
    fi

    if [ ! -d "${DATADIR}/mysql" ]; then
        user_error "MySQL 数据库未初始化，安装过程可能未成功完成，请尝试卸载后重新安装。"
        return 1
    fi

    if [ ! -f "${CNF_FILE}" ]; then
        user_error "MySQL 配置文件丢失，请尝试卸载后重新安装。"
        return 1
    fi

    # Ensure runtime directory exists
    mkdir -p "${TRIM_PKGVAR}/run"

    # Start mysqld (script runs as root; --user in mysql.cnf or cmd drops privileges)
    "${MYSQLD}" \
        --defaults-file="${CNF_FILE}" \
        --port="${MYSQL_PORT}" \
        --user="${TRIM_USERNAME}" >> "${LOG_FILE}" 2>&1 &
    local mysqld_pid=$!
    printf "%s" "${mysqld_pid}" > "${PID_FILE}"
    log_msg "mysqld started with PID=${mysqld_pid}, port=${MYSQL_PORT}"
    return 0
}

stop_process() {
    log_msg "Stopping MySQL ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            # process not exist, delete pidfile
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        # Graceful shutdown via mysqladmin (MySQL specific)
        if [ -n "${MYSQL_ROOT_PASSWORD}" ] && \
           [ -f "${TRIM_PKGETC}/.root_password_set" ]; then
            sudo -u "${TRIM_USERNAME}" "${MYSQLADMIN}" \
                --socket="${SOCKET_FILE}" \
                -u root -p"${MYSQL_ROOT_PASSWORD}" \
                shutdown >> "${LOG_FILE}" 2>&1
        else
            sudo -u "${TRIM_USERNAME}" "${MYSQLADMIN}" \
                --socket="${SOCKET_FILE}" \
                -u root \
                shutdown >> "${LOG_FILE}" 2>&1
        fi

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi    
    fi

    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
