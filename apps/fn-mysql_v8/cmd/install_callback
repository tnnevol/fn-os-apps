#!/bin/bash

### This script is called after the user installs the application.
### Extracts bundled MySQL 8.4.9 Debian packages and initializes the database.
### Requires: run-as = root (config/privilege)

MYSQL_VERSION="8.4.9"
DEB_BUNDLE="${TRIM_APPDEST}/server/mysql-server_${MYSQL_VERSION}-1debian12_amd64.deb-bundle.tar"
SERVER_DIR="${TRIM_APPDEST}/server"
MYSQLD="${SERVER_DIR}/usr/sbin/mysqld"
MYSQL_CLIENT="${SERVER_DIR}/usr/bin/mysql"
DATADIR="${TRIM_PKGHOME}/data"
CNF_FILE="${TRIM_PKGETC}/my.cnf"
SOCKET_FILE="${TRIM_PKGVAR}/mysql.sock"
MYSQL_PORT="${APP_PORT:-3306}"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
}

user_error() {
    echo "$1" > "${TRIM_TEMP_LOGFILE}"
    log "USER ERROR: $1"
}

# ─── Step 0: Architecture check ─────────────────────────────────────────────
ARCH=$(uname -m)
if [ "${ARCH}" != "x86_64" ]; then
    user_error "MySQL 原生应用仅支持 x86_64 架构，当前架构为 ${ARCH}。"
    exit 1
fi

# ─── Step 1: Create required directories ────────────────────────────────────
log "Creating directories ..."
mkdir -p "${DATADIR}"
mkdir -p "${TRIM_PKGVAR}/run"

# ─── Step 2: Extract deb bundle and install packages ────────────────────────
if [ ! -x "${MYSQLD}" ]; then
    log "Installing MySQL ${MYSQL_VERSION} from bundled Debian packages ..."

    BUNDLE_DIR="${TRIM_PKGTMP}/deb-bundle"
    mkdir -p "${BUNDLE_DIR}"

    # 2a. Extract the outer tar (only needed debs, skip debug/test/dev)
    log "Extracting deb packages ..."
    tar -xf "${DEB_BUNDLE}" -C "${BUNDLE_DIR}" \
        --exclude='*debug*' \
        --exclude='*test*' \
        --exclude='*dev*'

    # 2b. Extract each .deb's data archive into server/
    log "Installing MySQL files to ${SERVER_DIR} ..."
    for deb_file in "${BUNDLE_DIR}"/*.deb; do
        pkg_name=$(basename "${deb_file}" | cut -d_ -f1)
        log "  -> ${pkg_name}"

        TMPDIR_DEB="${TRIM_PKGTMP}/deb-extract"
        mkdir -p "${TMPDIR_DEB}"

        # Find exact data archive member name (e.g. data.tar.xz, data.tar.zst)
        DATA_MEMBER=$(ar t "${deb_file}" | grep '^data\.tar\.')
        if [ -z "${DATA_MEMBER}" ]; then
            log "  WARNING: no data archive found in ${pkg_name}, skipping"
            rm -rf "${TMPDIR_DEB}"
            continue
        fi

        # Extract inner data archive
        ar p "${deb_file}" "${DATA_MEMBER}" > "${TMPDIR_DEB}/${DATA_MEMBER}"

        # Extract to server/ directory (preserves ./usr/... paths)
        tar -xf "${TMPDIR_DEB}/${DATA_MEMBER}" -C "${SERVER_DIR}"

        rm -rf "${TMPDIR_DEB}"
    done

    # 2c. Clean up extracted debs
    rm -rf "${BUNDLE_DIR}"

    # 2d. Copy etc/ configuration files to TRIM_PKGETC and override
    if [ -d "${SERVER_DIR}/etc/mysql" ]; then
        log "Copying MySQL configuration files to ${TRIM_PKGETC} ..."
        mkdir -p "${TRIM_PKGETC}/mysql.conf.d"
        cp -r "${SERVER_DIR}/etc/mysql/"* "${TRIM_PKGETC}/"
        rm -rf "${SERVER_DIR}/etc"
        
        # Override mysql.cnf with correct includedir paths
        cat > "${TRIM_PKGETC}/mysql.cnf" << 'EOF'
# MySQL Server configuration file.
# Managed by fn-mysql_v8 application

# Include additional configuration directories
!includedir ${TRIM_PKGETC}/conf.d/
!includedir ${TRIM_PKGETC}/mysql.conf.d/
EOF
        # Replace variables in mysql.cnf
        sed -i "s|\${TRIM_PKGETC}|${TRIM_PKGETC}|g" "${TRIM_PKGETC}/mysql.cnf"
        
        # Override mysqld.cnf with correct paths
        cat > "${TRIM_PKGETC}/mysql.conf.d/mysqld.cnf" << EOF
[mysqld]
# Basic MySQL server configuration
# Managed by fn-mysql_v8 application

# Runtime files
pid-file        = ${TRIM_PKGVAR}/run/mysqld.pid
socket          = ${TRIM_PKGVAR}/mysql.sock

# Data directory
datadir         = ${TRIM_PKGHOME}/data

# Error log
log-error       = ${TRIM_PKGVAR}/error.log

# Slow query log (optional)
slow-query-log-file = ${TRIM_PKGVAR}/slow.log
EOF
        
        log "Configuration files updated with fnOS paths"
    fi

    # 2e. Remove the bundle tar to free disk space (~488MB)
    log "Removing deb bundle tar to free disk space ..."
    rm -f "${DEB_BUNDLE}"

    # 2f. Ensure plugin directory is accessible
    if [ -d "${SERVER_DIR}/usr/lib/mysql/plugin" ]; then
        log "MySQL plugin directory found"
    elif [ -d "${SERVER_DIR}/usr/lib/x86_64-linux-gnu/mysql/plugin" ]; then
        mkdir -p "${SERVER_DIR}/usr/lib/mysql"
        ln -sf "${SERVER_DIR}/usr/lib/x86_64-linux-gnu/mysql/plugin" \
               "${SERVER_DIR}/usr/lib/mysql/plugin"
        log "Linked plugin directory"
    fi

    # 2g. Verify mysqld binary
    if [ ! -x "${MYSQLD}" ]; then
        user_error "MySQL 安装失败:mysqld 可执行文件未找到,请重试。"
        exit 1
    fi

    log "MySQL ${MYSQL_VERSION} binaries installed successfully"
else
    log "MySQL binaries already installed, skipping extraction"
fi

# ─── Step 3: Create MySQL configuration file ────────────────────────────────
log "Creating MySQL configuration ..."
cat > "${CNF_FILE}" << EOF
[mysqld]
# Network
bind-address            = 0.0.0.0
port                    = ${MYSQL_PORT}
socket                  = ${SOCKET_FILE}
mysqlx                  = 0

# Paths
datadir                 = ${DATADIR}
basedir                 = ${SERVER_DIR}/usr
pid-file                = ${TRIM_PKGVAR}/run/mysqld.pid
log-error               = ${TRIM_PKGVAR}/error.log
slow-query-log-file     = ${TRIM_PKGVAR}/slow.log
secure-file-priv        =

# Performance
innodb-buffer-pool-size = 128M
max-connections         = 200

# Character set
character-set-server    = utf8mb4
collation-server        = utf8mb4_unicode_ci

# Compatibility (MySQL 8.4 native password support)
mysql-native-password   = on

[client]
socket                  = ${SOCKET_FILE}
EOF
log "Configuration written to ${CNF_FILE}"

# ─── Step 4: Set ownership and permissions ───────────────────────────────────
log "Setting ownership and permissions ..."
# Binaries/libs owned by root (read-only)
chown -R root:root "${SERVER_DIR}/usr"
chmod -R 755 "${SERVER_DIR}/usr"

# Data/config/runtime owned by app user
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGHOME}"
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGETC}"
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGVAR}"

chmod 750 "${DATADIR}"
chmod 700 "${TRIM_PKGVAR}"

# ─── Step 5: Initialize MySQL database ──────────────────────────────────────
if [ ! -d "${DATADIR}/mysql" ]; then
    log "Initializing MySQL database (--initialize-insecure) ..."

    "${MYSQLD}" \
        --defaults-file="${CNF_FILE}" \
        --user="${TRIM_USERNAME}" \
        --initialize-insecure

    if [ $? -ne 0 ]; then
        user_error "MySQL 数据库初始化失败，请查看应用日志了解详情。"
        exit 1
    fi

    # Ensure data ownership after init (mysqld --user handles this, but double-check)
    chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${DATADIR}"
    log "MySQL database initialized successfully"
else
    log "MySQL data directory already initialized, skipping"
fi

# ─── Step 6: Set root password and remote access (if wizard provided) ────────
if [ -n "${MYSQL_ROOT_PASSWORD}" ]; then
    log "Setting root password ..."

    # Start temporary MySQL instance to set password
    "${MYSQLD}" \
        --defaults-file="${CNF_FILE}" \
        --user="${TRIM_USERNAME}" \
        --port=0 \
        --skip-networking &
    TEMP_PID=$!

    # Wait for MySQL to start
    sleep 5

    # Check if process is still running
    if ! kill -0 $TEMP_PID 2>/dev/null; then
        user_error "MySQL 临时实例启动失败，无法设置密码。"
        exit 1
    fi

    # Set root password and optionally enable remote access
    SQL="ALTER USER 'root'@'localhost' IDENTIFIED BY '${MYSQL_ROOT_PASSWORD}';"
    
    if [ "${MYSQL_REMOTE_ACCESS}" = "any" ]; then
        SQL="${SQL}
        CREATE USER 'root'@'%' IDENTIFIED BY '${MYSQL_ROOT_PASSWORD}';
        GRANT ALL PRIVILEGES ON *.* TO 'root'@'%' WITH GRANT OPTION;"
        log "Enabling remote access (root@%) ..."
    else
        log "Remote access disabled (localhost only)"
    fi
    
    SQL="${SQL} FLUSH PRIVILEGES;"

    # Execute SQL
    "${MYSQL_CLIENT}" \
        --socket="${SOCKET_FILE}" -u root \
        -e "${SQL}"

    if [ $? -eq 0 ]; then
        log "Root password configured successfully"
    else
        log "WARNING: Failed to configure root password"
    fi

    # Stop temporary instance
    kill $TEMP_PID 2>/dev/null
    wait $TEMP_PID 2>/dev/null
fi

log "MySQL ${MYSQL_VERSION} Native installation completed!"
exit 0
