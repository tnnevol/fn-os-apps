#!/bin/bash

### This script is called after the user installs the application.

# 目录型挂载源必须预创建：Docker 在源不存在时会以 root 建出目录，属主与容器内运行用户不符，
# 导致应用对该挂载无写权限。以包用户建出后属主即本应用。

if [ -z "${TRIM_PKGVAR}" ]; then
    echo "TRIM_PKGVAR is not set; cannot prepare application data directory" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

mkdir -p "${TRIM_PKGVAR}/data/data"
mkdir -p "${TRIM_PKGVAR}/data/file"
mkdir -p "${TRIM_PKGVAR}/data/gsm3"
# 应用启动即 mkdir /root/server/logs，该路径在镜像层（归 root），
# 以包用户运行会 EACCES；compose 已把它挂到 data/logs，这里预建目录。
mkdir -p "${TRIM_PKGVAR}/data/logs"
mkdir -p "${TRIM_PKGVAR}/data/server"

chmod -R 770 "${TRIM_PKGVAR}/data" 2>/dev/null || true

echo "Prepared application data directory: ${TRIM_PKGVAR}/data"

exit 0
