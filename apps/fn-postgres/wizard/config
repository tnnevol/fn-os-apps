[
    {
        "stepTitle": "PostgreSQL 运行设置",
        "items": [
            {
                "type": "text",
                "field": "APP_PORT",
                "label": "数据库端口",
                "initValue": "55432",
                "helpText": "PostgreSQL 对外服务端口。默认 55432：设备上 5432 已被系统内置服务占用（仅监听本机），故避开。",
                "rules": [
                    {
                        "required": true,
                        "message": "请输入端口号"
                    },
                    {
                        "pattern": "^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|[6][0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                        "message": "端口号必须是 1—65535 之间的整数"
                    }
                ]
            },
            {
                "type": "text",
                "field": "DB_ROOT_USER",
                "label": "超级用户",
                "initValue": "postgres",
                "helpText": "数据库超级用户名。该值只在首次安装初始化时生效，事后修改不会重命名已有角色。",
                "rules": [
                    {
                        "required": true,
                        "message": "请输入超级用户名"
                    }
                ]
            },
            {
                "type": "password",
                "field": "DB_ROOT_PASSWORD",
                "label": "超级用户密码",
                "initValue": "",
                "helpText": "修改密码后请保存并重启应用。",
                "rules": [
                    {
                        "min": 6,
                        "max": 100,
                        "message": "密码长度 6-100 个字符"
                    }
                ]
            }
        ]
    }
]
