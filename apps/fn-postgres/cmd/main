#!/bin/bash

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"
COMPOSE_DIR="$(dirname "${FILE_PATH}")"
CONTAINER="fn-postgres"
PASSWORD_MARKER="${TRIM_PKGVAR}/.pg_root_password_pending"

is_docker_running() {
    local RUNNING
    RUNNING=$(docker compose -p "$TRIM_APPNAME" ps --format '{{.State}}' 2>/dev/null | grep -ci 'running')
    echo "[DEBUG] is_docker_running: $RUNNING running container(s)"
    [ "$RUNNING" -gt 0 ]
}

# 让 compose 的期望状态生效：容器缺失时创建，配置（如端口）变更后重建。
# 不要先判断「容器已存在」就 return —— 那样 up -d 永远不会被执行，
# 用户在「应用设置 → 运行设置」里改的端口就进不了容器。
# 配置未变时 up -d 只输出 Running、容器 ID 不变，是幂等的。
ensure_containers_created() {
    cd "$COMPOSE_DIR" || return 1
    echo "[DEBUG] running: docker compose -p $TRIM_APPNAME up -d"
    docker compose -p "$TRIM_APPNAME" up -d 2>&1
    if [ $? -ne 0 ]; then
        echo "[DEBUG] docker compose up -d FAILED"
        echo "Docker compose 创建容器失败" >"${TRIM_TEMP_LOGFILE}"
        return 1
    fi
    echo "[DEBUG] docker compose up -d OK"
    return 0
}

# 把 config_callback 记下的新密码真正写进数据库。
# config_callback 以包用户运行、没有 docker 权限，只能落标记；本脚本以 root 运行，
# 可以 docker exec 进容器执行 ALTER USER（容器内本地 socket 免密）。
# 密码里的单引号按 SQL 字面量规则转义（' -> ''）。
apply_pending_password() {
    [ -f "$PASSWORD_MARKER" ] || return 0

    if ! docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null | grep -q true; then
        echo "[DEBUG] 容器未运行，密码变更留待下次状态检查"
        return 0
    fi

    local NEW_PASSWORD ESCAPED USER_IDENT
    NEW_PASSWORD=$(cat "$PASSWORD_MARKER" 2>/dev/null)
    if [ -z "$NEW_PASSWORD" ]; then
        rm -f "$PASSWORD_MARKER"
        return 0
    fi

    ESCAPED="${NEW_PASSWORD//\'/\'\'}"
    USER_IDENT="${DB_ROOT_USER//\"/\"\"}"

    if docker exec -i "$CONTAINER" psql -U "${DB_ROOT_USER}" -d postgres \
        -c "ALTER USER \"${USER_IDENT}\" WITH PASSWORD '${ESCAPED}';" >/dev/null 2>&1; then
        rm -f "$PASSWORD_MARKER"
        echo "[DEBUG] 已将新密码写入数据库"
    else
        echo "[DEBUG] 密码写入失败，保留标记以便下次重试"
        echo "更新数据库超级用户密码失败，请稍后重试或重新保存配置" >"${TRIM_TEMP_LOGFILE}"
    fi
    return 0
}

case $1 in
start)
    # do nothing, docker application will be started by appcenter
    exit 0
    ;;
stop)
    # do nothing, docker application will be stopped by appcenter
    exit 0
    ;;
status)
    echo "[DEBUG] cmd/main called with action: $1"
    if ! ensure_containers_created; then
        exit 1
    fi
    apply_pending_password
    if is_docker_running; then
        echo "[DEBUG] container is running"
        exit 0
    else
        echo "[DEBUG] container is NOT running"
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
