#!/bin/bash

### This script is called after the user installs the application.

# PostgreSQL 镜像内置用户是 uid=70(postgres)/gid=70。挂载进来的数据目录
# 首次安装时不存在，Docker 会以 root 建出，容器内的 70 无法初始化数据库
# （initdb 需要在其 data 目录上写，失败会报
#  "data directory has wrong ownership" 并退出）。
# 因此预建目录并把属主对齐到镜像内 UID。
IMAGE_UID=70
IMAGE_GID=70

if [ -z "${TRIM_PKGVAR}" ]; then
    echo "TRIM_PKGVAR is not set; cannot prepare application data directory" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

DATA_DIR="${TRIM_PKGVAR}/data"
mkdir -p "${DATA_DIR}"

# 有权限时直接 chown；无权限时退化为 ACL，保证容器内 70 可读写。
chown -R "${IMAGE_UID}:${IMAGE_GID}" "${DATA_DIR}" 2>/dev/null || true
if [ "$(stat -c '%u' "${DATA_DIR}" 2>/dev/null)" != "${IMAGE_UID}" ]; then
    chmod 775 "${DATA_DIR}" 2>/dev/null || true
    setfacl -m "u:${IMAGE_UID}:rwx" "${DATA_DIR}" 2>/dev/null || true
    setfacl -d -m "u:${IMAGE_UID}:rwx" "${DATA_DIR}" 2>/dev/null || true
fi
# initdb 要求 data 目录权限为 700 或 750（不能是组/其他可写）
chmod 700 "${DATA_DIR}" 2>/dev/null || true

echo "Prepared PostgreSQL data directory: ${DATA_DIR}"

exit 0
