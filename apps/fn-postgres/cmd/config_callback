#!/bin/bash

### This script is called after the user change environment variables in application setting page.

# 用户在「应用设置」里改了超级用户密码后，新密码必须真正落到数据库里：
# PostgreSQL 只在**首次初始化**时读取 POSTGRES_PASSWORD，容器重建也不会改已有数据的密码。
#
# 但本脚本以**包用户**身份运行，没有 /var/run/docker.sock 权限（该 socket 属 root:docker），
# 无法 `docker exec` 进容器执行 ALTER USER。所以这里只落一个标记文件，
# 由以 **root** 运行的 cmd/main 在下次状态检查时读取标记并执行 ALTER USER。
#
# 标记文件放在 TRIM_PKGVAR（包用户对该目录有写权限），权限 600，
# 生效后由 cmd/main 立即删除，不长期留存明文。
#
# 端口改动不在这里处理：由 cmd/main 的 `docker compose up -d` 生效。
#
# 全程 exit 0：平台会检查回调退出码，非 0 会让「保存并重启」整体失败。

if [ -z "${TRIM_PKGVAR}" ] || [ -z "${DB_ROOT_PASSWORD}" ]; then
    exit 0
fi

MARKER="${TRIM_PKGVAR}/.pg_root_password_pending"

umask 077
if printf '%s' "${DB_ROOT_PASSWORD}" >"${MARKER}" 2>/dev/null; then
    chmod 600 "${MARKER}" 2>/dev/null || true
    echo "已记录密码变更，将在下次状态检查时写入数据库"
else
    echo "无法记录密码变更（${MARKER} 不可写），本次修改未生效"
    [ -n "${TRIM_TEMP_LOGFILE}" ] && echo "无法记录密码变更（${MARKER} 不可写），本次修改未生效" >"${TRIM_TEMP_LOGFILE}"
fi

exit 0
