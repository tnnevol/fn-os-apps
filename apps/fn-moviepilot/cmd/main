#!/bin/bash

export PATH=/var/apps/python312/target/bin:$PATH
export PATH="${TRIM_APPDEST}/app/bin:$PATH"
export HOME="$TRIM_PKGHOME"

APP_DIR="${TRIM_PKGHOME}/MoviePilot"
CONFIG_DIR="${TRIM_APPDEST_VOL}/@appshare/fn-moviepilot"

# 获取 NAS 主用户（UID 1000），不存在则回退到应用专用用户
if id -u 1000 &>/dev/null; then
    NAS_MAIN_USER=$(id -un 1000)
    NAS_MAIN_GROUP=$(id -gn 1000)
else
    NAS_MAIN_USER="$TRIM_USERNAME"
    NAS_MAIN_GROUP="$TRIM_GROUPNAME"
fi

# 从 app.env 读取端口配置（service.js 运行时读取）
if [ -f "$CONFIG_DIR/app.env" ]; then
    . "$CONFIG_DIR/app.env"
    export PORT NGINX_PORT
fi

START_CMD="runuser -u '${NAS_MAIN_USER}' -- bash -c 'cd ${APP_DIR} && exec ${TRIM_APPDEST}/app/bin/moviepilot start'"
STOP_CMD="runuser -u '${NAS_MAIN_USER}' -- bash -c 'cd ${APP_DIR} && exec ${TRIM_APPDEST}/app/bin/moviepilot stop'"
STATUS_CMD="runuser -u '${NAS_MAIN_USER}' -- bash -c 'cd ${APP_DIR} && exec ${TRIM_APPDEST}/app/bin/moviepilot status'"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >&2
}

# 修复目录所有权，防止文件归属不一致
fix_ownership() {
    chown -R "${NAS_MAIN_USER}:${NAS_MAIN_GROUP}" \
        "${TRIM_APPDEST}" \
        "${TRIM_PKGVAR}" \
        "${TRIM_PKGHOME}" \
        "${CONFIG_DIR}" \
        2>/dev/null || true
}

start_process() {
    if status; then
        return 0
    fi

    fix_ownership
    log_msg "Starting process as ${NAS_MAIN_USER} ..."
    bash -c "${START_CMD}" >&2
    return 0
}

stop_process() {
    log_msg "Stopping process ..."
    bash -c "${STOP_CMD}" >&2
    return 0
}

status() {
    # 检查重启状态文件，如果存在则返回 0（正在维护中）
    if [ -f "${TRIM_PKGVAR}/restarting" ]; then
        return 0
    fi

    # 使用 moviepilot status 命令检测实际运行状态
    local status_output
    status_output=$(bash -c "${STATUS_CMD}" 2>&1)

    # 检查 Backend 和 Frontend 是否都在运行
    if echo "$status_output" | grep -q "Backend:" &&
        echo "$status_output" | grep -A5 "Backend:" | grep -q "running" &&
        echo "$status_output" | grep -q "Frontend:" &&
        echo "$status_output" | grep -A5 "Frontend:" | grep -q "running"; then
        return 0 # 服务正在运行
    fi

    return 1 # 服务未运行
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    start_process
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_process
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    fix_ownership
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
