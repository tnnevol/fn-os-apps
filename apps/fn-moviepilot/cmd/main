#!/bin/bash

PID_FILE="${TRIM_PKGVAR}/app.pid"

export PATH=/var/apps/python312/target/bin:$PATH
export PATH="${TRIM_APPDEST}/app/bin:$PATH"

APP_DIR="${TRIM_PKGHOME}/MoviePilot"
CONFIG_DIR="${TRIM_APPDEST_VOL}/@appshare/fn-moviepilot"

# 从 app.env 读取端口配置（service.js 运行时读取）
if [ -f "$CONFIG_DIR/app.env" ]; then
    . "$CONFIG_DIR/app.env"
    export PORT NGINX_PORT
fi

START_CMD="cd '${APP_DIR}' && exec '${TRIM_APPDEST}/app/bin/moviepilot' start"
STOP_CMD="cd '${APP_DIR}' && exec '${TRIM_APPDEST}/app/bin/moviepilot' stop"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >&2
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting process ..."
    # run cmd to start process, capture output to extract PIDs
    local output
    output=$(bash -c "${START_CMD}" 2>&1)
    echo "$output" >&2

    # extract Backend PID and Frontend PID
    local backend_pid frontend_pid
    backend_pid=$(echo "$output" | grep -oP 'Backend PID:\s*\K\d+')
    frontend_pid=$(echo "$output" | grep -oP 'Frontend PID:\s*\K\d+')

    if [ -n "$backend_pid" ] && [ -n "$frontend_pid" ]; then
        # write both PIDs to pidfile (backend first, frontend second)
        printf "%s\n%s\n" "$backend_pid" "$frontend_pid" > "${PID_FILE}"
        log_msg "PIDs saved: backend=$backend_pid, frontend=$frontend_pid"
    else
        log_msg "Warning: Could not extract PIDs from output"
        # fallback: use bash PID
        printf "%s" "$!" > "${PID_FILE}"
    fi
    return 0
}

stop_process() {
    log_msg "Stopping process ..."
    bash -c "${STOP_CMD}" >&2
    rm -f "${PID_FILE}"
    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi    
    fi

    return 1
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    start_process
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_process
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    if status; then 
        exit 0
    else 
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
