#!/bin/bash

export PATH=/var/apps/python312/target/bin:$PATH
export PATH="${TRIM_APPDEST}/app/bin:$PATH"

APP_DIR="${TRIM_PKGHOME}/MoviePilot"
CONFIG_DIR="${TRIM_APPDEST_VOL}/@appshare/fn-moviepilot"

# 从 app.env 读取端口配置（service.js 运行时读取）
if [ -f "$CONFIG_DIR/app.env" ]; then
    . "$CONFIG_DIR/app.env"
    export PORT NGINX_PORT
fi

START_CMD="cd '${APP_DIR}' && exec '${TRIM_APPDEST}/app/bin/moviepilot' start"
STOP_CMD="cd '${APP_DIR}' && exec '${TRIM_APPDEST}/app/bin/moviepilot' stop"
STATUS_CMD="cd '${APP_DIR}' && exec '${TRIM_APPDEST}/app/bin/moviepilot' status"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >&2
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting process ..."
    bash -c "${START_CMD}" >&2
    return 0
}

stop_process() {
    log_msg "Stopping process ..."
    bash -c "${STOP_CMD}" >&2
    return 0
}

status() {
    # 使用 moviepilot status 命令检测实际运行状态
    local status_output
    status_output=$(bash -c "${STATUS_CMD}" 2>&1)
    
    # 检查 Backend 和 Frontend 是否都在运行
    if echo "$status_output" | grep -q "Backend:" && \
       echo "$status_output" | grep -A5 "Backend:" | grep -q "running" && \
       echo "$status_output" | grep -q "Frontend:" && \
       echo "$status_output" | grep -A5 "Frontend:" | grep -q "running"; then
        return 0  # 服务正在运行
    fi
    
    return 1  # 服务未运行
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    start_process
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_process
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    if status; then 
        exit 0
    else 
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
