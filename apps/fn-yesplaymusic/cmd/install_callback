#!/bin/bash

### This script is called after the user installs the application.

# 目录型挂载源需要预创建；否则 Docker 会以 root 建出属主错误的目录。
if [ -z "${TRIM_PKGVAR}" ]; then
    echo "TRIM_PKGVAR is not set; cannot prepare application data directory" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

# nginx 以包用户运行时要写这两个目录（见 compose 注释），必须由包用户预先创建，
# 否则 Docker 以 root 建出来，nginx 仍会 Permission denied。
mkdir -p "${TRIM_PKGVAR}/cache"
mkdir -p "${TRIM_PKGVAR}/run"

echo "Prepared application data directory: ${TRIM_PKGVAR}"

exit 0
