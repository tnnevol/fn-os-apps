#!/bin/bash

### This script is called after the user installs the application.

# 配置生成已交给容器自己的启动命令（见 compose：缺 homeserver.yaml 时先跑
# /start.py generate 再启动）。原因：容器由应用中心在回调之前创建，
# 在回调里写配置赶不上首次启动，容器会以「配置不存在」进入重启循环。
# 回调只负责把数据目录建出来，避免 Docker 以 root 建出属主错误的目录。
if [ -z "${TRIM_PKGVAR}" ]; then
    echo "TRIM_PKGVAR is not set; cannot prepare application data directory" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

DATA_DIR="${TRIM_PKGVAR}/data"
mkdir -p "${DATA_DIR}"

chown -R "${TRIM_USERNAME:-${TRIM_UID}}:${TRIM_GROUPNAME:-${TRIM_GID}}" "${DATA_DIR}" 2>/dev/null || true
chmod -R 770 "${DATA_DIR}" 2>/dev/null || true

echo "Prepared application data directory: ${DATA_DIR}"

exit 0
