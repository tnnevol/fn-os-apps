#!/bin/bash

### This script is called after the application is installed.
### Set up bundled Memos binary and persist wizard env vars.

BIN_DIR="${TRIM_APPDEST}/bin"
CNF_DIR="${TRIM_APPDEST}/wizard"
CNF_FILE="${CNF_DIR}/install.cnf"

mkdir -p "${TRIM_PKGVAR}/data"
mkdir -p "${CNF_DIR}"

# 持久化向导配置，供 CGI 重启时读取
cat > "${CNF_FILE}" <<EOF
MEMOS_PORT="${wizard_port:-5230}"
MEMOS_STORAGE="${wizard_storage_type:-local}"
MEMOS_DSN="${wizard_dsn:-}"
EOF

if [ -f "${BIN_DIR}/memos" ]; then
    chmod +x "${BIN_DIR}/memos"
    echo "Memos bundled binary installed successfully"
else
    echo "Warning: Bundled Memos binary not found"
fi

exit 0
