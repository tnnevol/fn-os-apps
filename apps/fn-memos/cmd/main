#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# Memos binary path and data directory (required for assets even with external DB)
MEMOS_BIN="${TRIM_APPDEST}/bin/memos"
MEMOS_PORT="${wizard_port:-5230}"
DATA_DIR="${TRIM_PKGVAR}/data"

# 启动 memos。
#
# 这里**不能**把整条命令拼成一个字符串再交给 `bash -c`：DSN 里的密码常含 `$`、
# 反引号、反斜杠等字符，二次解析会把它们展开掉。实测密码 `pa$$w0rd` 经
# `bash -c "${CMD}"` 后被替换成 `pa<当前PID>w0rd`，连接串被静默改坏，
# 表现为「填的 DSN 没错却连不上数据库」。
# 直接以参数形式启动，每个变量各自加引号，shell 不会再解释其内容。
start_memos() {
    case "${wizard_storage_type}" in
    mysql)
        "${MEMOS_BIN}" --port "${MEMOS_PORT}" --data "${DATA_DIR}" \
            --driver mysql --dsn "${wizard_dsn}" >>"${LOG_FILE}" 2>&1 &
        ;;
    postgres)
        "${MEMOS_BIN}" --port "${MEMOS_PORT}" --data "${DATA_DIR}" \
            --driver postgres --dsn "${wizard_dsn}" >>"${LOG_FILE}" 2>&1 &
        ;;
    *)
        # 本地 SQLite：不传 --driver/--dsn，数据库落在数据目录
        "${MEMOS_BIN}" --port "${MEMOS_PORT}" --data "${DATA_DIR}" >>"${LOG_FILE}" 2>&1 &
        ;;
    esac
    MEMOS_PID=$!
}

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >>"${LOG_FILE}"
}

# 按可执行文件路径找残留进程。
# 只依赖 PID 文件是不够的：PID 文件丢失（升级、异常退出、被清理）后，
# 仍在运行的 memos 会变成孤儿进程，继续占着端口。下次启动就报「端口被占用」，
# 而且 stop 什么也停不掉 —— 这正是「重启后仍提示端口被占用」的成因。
find_orphans() {
    # 用 ^ 锚定命令行**开头**：memos 进程的 cmdline 就是
    # "<二进制路径> --port ..."。不锚定的话，任何命令行里恰好提到这个路径的
    # shell（例如运维手敲的 pgrep、或 `bash -c "<二进制> --port ..."` 的包装进程）
    # 都会被当成孤儿，导致清理列表被污染、等待循环永远退不出去。
    pgrep -f "^${MEMOS_BIN} --port" 2>/dev/null || true
}

cleanup_orphans() {
    local pids
    pids="$(find_orphans)"
    [ -z "$pids" ] && return 0
    log_msg "发现残留 memos 进程：$(echo "$pids" | tr '\n' ' ')，先清理"
    for pid in $pids; do
        # 排除当前脚本自身
        [ "$pid" = "$$" ] && continue
        kill -TERM "$pid" 2>>"${LOG_FILE}" || log_msg "TERM 发送失败 pid=$pid"
    done
    local count=0
    while [ -n "$(find_orphans)" ] && [ $count -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done
    for pid in $(find_orphans); do
        log_msg "残留进程未响应 TERM，强制结束 pid=$pid"
        # 不吞错误：跨用户（脚本身份与被清理进程身份不同）时 kill 会失败，
        # 静默忽略会让人以为已经清理干净，实际端口仍被占着。
        if ! kill -KILL "$pid" 2>>"${LOG_FILE}"; then
            log_msg "无法结束 pid=$pid（权限不足？请确认生命周期脚本以应用所属用户运行）"
        fi
    done
    rm -f "${PID_FILE}"
    return 0
}

start_process() {
    if status; then
        # 进程其实在跑（常见于 PID 文件丢失/被清理）。此时**不能**再起一个实例，
        # 否则第二个会因端口被自己占用而失败，表现成「重启后仍提示端口被占用」。
        # 顺手把在跑进程的 PID 补回 PID 文件，让后续 stop/status 精确可控，
        # 不必每次都依赖兜底扫描。
        if [ ! -r "${PID_FILE}" ]; then
            local existing
            existing="$(find_orphans | head -n 1)"
            if [ -n "${existing}" ]; then
                printf "%s" "${existing}" >"${PID_FILE}"
                log_msg "PID 文件缺失但进程已在运行，接管 pid=${existing}"
            fi
        fi
        return 0
    fi

    # PID 文件可能已失效但进程仍在，先兜底清理，避免撞端口
    cleanup_orphans

    log_msg "Starting Memos (storage: ${wizard_storage_type:-local}) ..."
    MEMOS_PID=""
    start_memos
    if [ -z "${MEMOS_PID}" ]; then
        log_msg "启动失败：未能获得进程号"
        return 1
    fi
    printf "%s" "${MEMOS_PID}" >"${PID_FILE}"
    log_msg "Memos started with pid ${MEMOS_PID}"
    return 0
}

stop_process() {
    log_msg "Stopping Memos ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove pid file"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >>"${LOG_FILE}" 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
        fi

        rm -f "${PID_FILE}"
    fi

    # 无论 PID 文件是否可用，都按可执行路径兜底清理一次
    cleanup_orphans

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi

    # PID 文件缺失/失效时，按可执行路径兜底判断：进程其实在跑就不能报「未运行」，
    # 否则框架会反复拉起新实例，而每一个都会因端口被自己占用而失败。
    if [ -n "$(find_orphans)" ]; then
        return 0
    fi

    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
