[
  {
    "stepTitle": "${config.stepTitle}",
    "items": [
      {
        "type": "text",
        "field": "wizard_port",
        "label": "${config.portLabel}",
        "initValue": "5230",
        "helpText": "${config.portHelpText}",
        "rules": [
          {
            "required": true,
            "message": "${config.portRequiredMessage}"
          },
          {
            "pattern": "^[0-9]+$",
            "message": "${config.portPatternMessage}"
          }
        ]
      },
      {
        "type": "select",
        "field": "wizard_storage_type",
        "label": "${config.storageLabel}",
        "initValue": "local",
        "helpText": "${config.storageHelpText}",
        "options": [
          {
            "label": "${config.storageOptionLocal}",
            "value": "local"
          },
          {
            "label": "${config.storageOptionMysql}",
            "value": "mysql"
          },
          {
            "label": "${config.storageOptionPostgres}",
            "value": "postgres"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_dsn",
        "label": "${config.dsnLabel}",
        "initValue": "",
        "helpText": "${config.dsnHelpText}"
      }
    ]
  }
]
