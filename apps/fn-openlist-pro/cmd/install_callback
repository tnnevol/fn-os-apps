#!/bin/bash


BIN_DIR="${TRIM_APPDEST}/bin"
DATA_DIR="${TRIM_PKGVAR}/data"

# 定义 install_callback 日志函数
log_msg() {
    echo "install_callback: $(date '+%Y-%m-%d %H:%M:%S') - $1"
}


# 解压 openlist 二进制
TARBALL="${BIN_DIR}/openlist-linux-musl-amd64.tar.gz"
if [ -f "${TARBALL}" ]; then
    log_msg "Extracting ${TARBALL} ..."
    tar -xzf "${TARBALL}" -C "${BIN_DIR}/"
    rm -f "${TARBALL}"
    log_msg "Extraction complete"
fi

chmod +x "${BIN_DIR}/openlist"
log_msg "OpenList installed to ${BIN_DIR}/openlist"

# 设置 admin 密码
if [ -n "${wizard_password}" ]; then
    log_msg "Setting admin password..."
    "${BIN_DIR}/openlist" admin set "${wizard_password}" --data "${DATA_DIR}"
    log_msg "Admin password set successfully"
    sleep 2
fi

# 更新 config.json 文件中的 http_port
CONFIG_FILE="${DATA_DIR}/config.json"
if [ -f "${CONFIG_FILE}" ] && [ -n "${wizard_port}" ]; then
    sed -i "s/\"http_port\": [0-9]*/\"http_port\": ${wizard_port}/g" "${CONFIG_FILE}"
    log_msg "Updated http_port to ${wizard_port} in config.json"
fi

exit 0
