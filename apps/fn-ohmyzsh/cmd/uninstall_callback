#!/bin/bash
#
# uninstall_callback — 应用卸载后执行
# 基于 Oh My Zsh 官方 uninstall.sh 适配，去除所有交互行为
# 通过 wizard_action 控制是否清理数据
#

# ── 路径定义 ──────────────────────────────────────────────

ZDOTDIR="${TRIM_APPDEST_VOL}/@appshare/fn-ohmyzsh"
ZSH="${TRIM_PKGHOME}/.oh-my-zsh"
ZSHRC="${ZDOTDIR}/.zshrc"
ZSHRC_BACKUP="${ZDOTDIR}/.zshrc.pre-oh-my-zsh"

# ── 工具函数 ──────────────────────────────────────────────

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >&2
}

# ── 根据用户选择决定是否清理数据 ─────────────────────────

if [ "$wizard_action" = "delete" ]; then
  log_msg "User chose to delete all data."

  # 删除 Oh My Zsh 仓库
  if [ -d "$ZSH" ]; then
    log_msg "Removing $ZSH ..."
    rm -rf "$ZSH"
    log_msg "Oh My Zsh directory removed."
  else
    log_msg "Oh My Zsh directory not found at $ZSH, skipping."
  fi

  # 删除 .zshrc
  if [ -e "$ZSHRC" ]; then
    log_msg "Removing $ZSHRC ..."
    rm -f "$ZSHRC"
    log_msg ".zshrc removed."
  fi

  # 删除备份文件
  if [ -e "$ZSHRC_BACKUP" ]; then
    log_msg "Removing backup $ZSHRC_BACKUP ..."
    rm -f "$ZSHRC_BACKUP"
    log_msg "Backup file removed."
  fi

  log_msg "All data deleted."
else
  log_msg "User chose to keep data. Data preserved at:"
  log_msg "  Oh My Zsh: $ZSH"
  log_msg "  Config:    $ZSHRC"
fi

log_msg "Uninstall complete."

exit 0
