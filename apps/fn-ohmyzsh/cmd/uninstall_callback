#!/bin/bash
#
# uninstall_callback — 应用卸载后执行
# 基于 Oh My Zsh 官方 uninstall.sh 适配，去除所有交互行为
# 通过 wizard_action 控制是否清理数据
#

# ── 路径定义 ──────────────────────────────────────────────

ZDOTDIR="${TRIM_APPDEST_VOL}/@appshare/fn-ohmyzsh"
ZSH="${TRIM_PKGHOME}/.oh-my-zsh"
ZSHRC="${ZDOTDIR}/.zshrc"
ZSHRC_BACKUP="${ZDOTDIR}/.zshrc.pre-oh-my-zsh"

# ── 工具函数 ──────────────────────────────────────────────

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >&2
}

# ── 清理系统级 zsh 配置 ─────────────────────────────────

log_msg "Cleaning up system-level zsh configuration ..."

# 恢复所有用户的默认 shell 为 bash
while IFS=: read -r username _ uid _ _ home shell; do
  # 跳过系统用户（UID < 1000）和无 home 的用户
  [ "$uid" -ge 1000 ] 2>/dev/null || continue
  [ -n "$home" ] && [ -d "$home" ] || continue

  # 恢复默认 shell 为 bash
  if [ "$shell" != "/bin/bash" ]; then
    if chsh -s "/bin/bash" "$username" 2>/dev/null; then
      log_msg "Changed shell for $username to /bin/bash"
    else
      log_msg "Failed to change shell for $username"
    fi
  fi
done < /etc/passwd

# 删除 /etc/zsh/zshenv
if [ -f /etc/zsh/zshenv ]; then
  rm -f /etc/zsh/zshenv
  log_msg "Removed /etc/zsh/zshenv"
fi

log_msg "System cleanup complete."

# ── 根据用户选择决定是否清理数据 ─────────────────────────

if [ "$wizard_action" = "delete" ]; then
  log_msg "User chose to delete all data."

  # 删除 Oh My Zsh 仓库
  if [ -d "$ZSH" ]; then
    log_msg "Removing $ZSH ..."
    rm -rf "$ZSH"
    log_msg "Oh My Zsh directory removed."
  else
    log_msg "Oh My Zsh directory not found at $ZSH, skipping."
  fi

  # 删除 .zshrc
  if [ -e "$ZSHRC" ]; then
    log_msg "Removing $ZSHRC ..."
    rm -f "$ZSHRC"
    log_msg ".zshrc removed."
  fi

  # 删除备份文件
  if [ -e "$ZSHRC_BACKUP" ]; then
    log_msg "Removing backup $ZSHRC_BACKUP ..."
    rm -f "$ZSHRC_BACKUP"
    log_msg "Backup file removed."
  fi

  log_msg "All data deleted."
else
  log_msg "User chose to keep data. Data preserved at:"
  log_msg "  Oh My Zsh: $ZSH"
  log_msg "  Config:    $ZSHRC"
fi

log_msg "Uninstall complete."

exit 0
