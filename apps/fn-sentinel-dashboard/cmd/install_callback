#!/bin/bash

### This script is called after the user installs the application.

# 容器以包用户运行（见 compose），HOME 指向 /appdata，Sentinel 会在其下写 logs/csp。
# 数据目录首次安装时不存在，必须先建出来，否则 Docker 以 root 建出、包用户写不进去。
if [ -z "${TRIM_PKGVAR}" ]; then
    echo "TRIM_PKGVAR is not set; cannot prepare application data directory" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

DATA_DIR="${TRIM_PKGVAR}/data"
mkdir -p "${DATA_DIR}/logs/csp"

chown -R "${TRIM_USERNAME:-${TRIM_UID}}:${TRIM_GROUPNAME:-${TRIM_GID}}" "${DATA_DIR}" 2>/dev/null || true
chmod -R 775 "${DATA_DIR}" 2>/dev/null || true

if touch "${DATA_DIR}/logs/csp/.write_check" 2>/dev/null; then
    rm -f "${DATA_DIR}/logs/csp/.write_check"
    echo "Prepared Sentinel log directory: ${DATA_DIR}/logs/csp"
else
    echo "Sentinel log directory is not writable: ${DATA_DIR}/logs/csp" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

exit 0
