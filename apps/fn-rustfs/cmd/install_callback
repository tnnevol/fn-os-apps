#!/bin/bash

### This script is called after the user installs the application.

# RustFS 镜像内置用户是 uid=10001(rustfs)，与 fnOS 包用户（9xx）不同。
# 挂载进来的 ${TRIM_PKGVAR}/data 属主是包用户，容器内的 10001 写不进去，
# 启动即报：
#   [FATAL] Server runtime failed: Io error: Permission denied (os error 13)
# 用 ACL 把访问权授予镜像内 UID，并设默认 ACL，让容器后续新建的对象也带权限
# （否则容器建的目录事后连包用户自己也删不掉）。
IMAGE_UID=10001

if [ -z "${TRIM_PKGVAR}" ]; then
    echo "TRIM_PKGVAR is not set; cannot prepare application data directory" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

DATA_DIR="${TRIM_PKGVAR}/data"
mkdir -p "${DATA_DIR}"

chmod 775 "${DATA_DIR}" 2>/dev/null || true
setfacl -m "u:${IMAGE_UID}:rwx" "${DATA_DIR}" 2>/dev/null || true
setfacl -d -m "u:${IMAGE_UID}:rwx" "${DATA_DIR}" 2>/dev/null || true
setfacl -d -m "u:${TRIM_RUN_UID:-${TRIM_UID}}:rwx" "${DATA_DIR}" 2>/dev/null || true

echo "Prepared RustFS data directory with ACL for image uid ${IMAGE_UID}: ${DATA_DIR}"

exit 0
