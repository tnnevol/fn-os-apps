#!/bin/bash
#
# uninstall_callback — NVM 卸载后执行
#

set -e

NVM_DIR="${TRIM_PKGHOME}/.nvm"
NVM_PROFILE_BEGIN="# >>> fn-nvm profile >>>"
NVM_PROFILE_END="# <<< fn-nvm profile <<<"

UID1000_ENTRY="$(getent passwd 1000 2>/dev/null || true)"
if [ -n "$UID1000_ENTRY" ]; then
    IFS=: read -r UID1000_USER _ UID1000_UID UID1000_GID _ UID1000_HOME UID1000_SHELL <<EOF
$UID1000_ENTRY
EOF
fi

run_as_uid1000() {
    [ -n "$UID1000_USER" ] || return 1
    command -v runuser >/dev/null 2>&1 || return 1
    runuser -u "$UID1000_USER" -- env \
        HOME="$UID1000_HOME" USER="$UID1000_USER" LOGNAME="$UID1000_USER" \
        NVM_DIR="$NVM_DIR" "$@"
}

for profile in \
    "${UID1000_HOME}/.bashrc" \
    "${UID1000_HOME}/.bash_profile" \
    "${UID1000_HOME}/.zshrc" \
    "${UID1000_HOME}/.zprofile" \
    "${UID1000_HOME}/.profile"; do
    if [ -f "$profile" ] && grep -Fq "$NVM_PROFILE_BEGIN" "$profile"; then
        run_as_uid1000 sed -i "/^${NVM_PROFILE_BEGIN}$/,/^${NVM_PROFILE_END}$/d" "$profile" || true
    fi
done

if [ "${wizard_action:-keep}" = "delete" ] && [ -n "$NVM_DIR" ] && [ "$NVM_DIR" != "/" ]; then
    rm -rf "$NVM_DIR"
fi

exit 0
