#!/bin/bash

### This script is called after the user installs the application.

if [ -z "${TRIM_PKGVAR}" ]; then
    echo "TRIM_PKGVAR is not set; cannot prepare application data directory" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

DATA_DIR="${TRIM_PKGVAR}/data"
mkdir -p "${DATA_DIR}"

# 本应用沿用镜像自带身份（uid=1001，见 compose 的 USER-EXCEPTION），而 TRIM_PKGVAR 归
# fnOS 包用户所有，两者 uid 不同 → 镜像 bootstrap 里的 `mv -f /tmp/mysql/* /var/lib/mysql/`
# 会 Permission denied（真机日志）。
#
# 这里不改属主（包用户没有 chown 权限），而是用 ACL 双向授权：
#   1. `u:1001:rwx`      —— 让容器（uid 1001）能写这个目录；
#   2. **default ACL**   —— 让容器后续新建的子目录/文件自动继承包用户权限，
#                          否则卸载时包用户进不去 uid 1001 的子目录，
#                          「删除所有数据」会留下 mysql/performance_schema 等残留。
# 实测：只加第 1 条时卸载后残留 5 个目录；补上 default ACL 才能清干净。
IMAGE_UID=1001
SELF_UID="$(id -u)"
if command -v setfacl >/dev/null 2>&1; then
    setfacl -m "u:${IMAGE_UID}:rwx" "${DATA_DIR}" 2>/dev/null ||
        echo "WARN: setfacl failed on ${DATA_DIR}" >"${TRIM_TEMP_LOGFILE}"
    setfacl -R -m "u:${IMAGE_UID}:rwx" "${DATA_DIR}" 2>/dev/null || true
    # 关键：默认 ACL，保证容器新建的子目录对包用户可读写，卸载时删得掉。
    # group 必须给 rwx —— ACL 的 mask 由「所有具名用户条目 + group 条目」的并集决定；
    # 若这里给 r-x，容器建出来的子目录会是 `drwxr-x---+ mask::r-x`，把
    # `user:docker-fn-huginn:rwx` 压成 `r-x`，包用户连目录都进不去，卸载时删不掉
    # （真机实测：残留 5 个 mysql/performance_schema 目录，且 `sudo -u #910 ls` 被拒）。
    setfacl -m "d:u::rwx,d:u:${IMAGE_UID}:rwx,d:u:${SELF_UID}:rwx,d:g::rwx,d:m::rwx,d:o::---" \
        "${DATA_DIR}" 2>/dev/null ||
        echo "WARN: default ACL failed on ${DATA_DIR}" >"${TRIM_TEMP_LOGFILE}"
else
    echo "WARN: setfacl not available; ${DATA_DIR} may not be writable by uid ${IMAGE_UID}" >"${TRIM_TEMP_LOGFILE}"
fi

echo "Prepared application data directory: ${DATA_DIR} (granted uid ${IMAGE_UID})"

exit 0
