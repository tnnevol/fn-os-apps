#!/bin/bash

### This script is called after the user installs the application.

# 两类目录需要预创建：
#   1) 共享目录（用户可见，fnOS 会自动创建 data-share 声明的共享根；此处补建其下按用途划分的子目录）——
#      Docker 不会自动创建绑定挂载的宿主目录，缺失时可能以 root 建出属主错误的目录。
#   2) 应用私有数据目录（用户不可见）。

# 共享目录根：与既有用户应用 fn-xiaoya-only 同构，落在 <存储卷>/@appshare/<appname>/。
# 卷号由 TRIM_APPDEST_VOL 提供（安装时用户选择的存储空间），不能写死。
SHARE_ROOT="${TRIM_APPDEST_VOL}/@appshare/fn-xiaomusic"
if [ -z "${TRIM_APPDEST_VOL}" ]; then
    # 不静默继续：该变量为空时路径会退化为 /@appshare/...（数据落到错误位置，且不报错）。
    echo "TRIM_APPDEST_VOL is empty; shared directories cannot be prepared" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

if [ -z "${TRIM_PKGVAR}" ]; then
    echo "TRIM_PKGVAR is not set; cannot prepare application data directory" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

# 共享目录下按用途划分的子目录（宿主侧只有一个 share）
mkdir -p "${SHARE_ROOT}/music"

# 应用私有数据目录
mkdir -p "${TRIM_PKGVAR}/data/conf"

# 单文件挂载要求源文件在容器启动前就存在（Docker 不会替你建文件）。
# 容器把日志固定写到 /app/xiaomusic.log.txt，这里预建对应的宿主文件并保证可写。
LOG_FILE="${TRIM_PKGVAR}/data/xiaomusic.log.txt"
touch "${LOG_FILE}"
chown "${TRIM_USERNAME:-${TRIM_UID}}:${TRIM_GROUPNAME:-${TRIM_GID}}" "${LOG_FILE}" 2>/dev/null || true
chmod 660 "${LOG_FILE}" 2>/dev/null || true

chmod -R 770 "${TRIM_PKGVAR}/data" 2>/dev/null || true

if touch "${TRIM_PKGVAR}/data/.write_check" 2>/dev/null; then
    rm -f "${TRIM_PKGVAR}/data/.write_check"
else
    echo "Application data directory is not writable: ${TRIM_PKGVAR}/data" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

echo "Prepared application data directory: ${TRIM_PKGVAR}/data"

echo "Shared directories are under: ${SHARE_ROOT}"

exit 0
