#!/bin/bash

### This script is called after the user installs the application.

# 单文件挂载要求源文件在容器启动前就已存在且内容可用（Docker 不会自动创建文件）；
# 目录型挂载源同样需要预创建（否则 Docker 会以 root 建出属主错误的目录）。
if [ -z "${TRIM_PKGVAR}" ]; then
    echo "TRIM_PKGVAR is not set; cannot prepare application data directory" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

DATA_DIR="${TRIM_PKGVAR}/data"
mkdir -p "${DATA_DIR}"

# 镜像内进程固定以 uid=1000 / gid=0 运行（langflowai/langflow 的 Dockerfile 里 USER user），
# 与 fnOS 的包用户无关。宿主侧目录若归 root/包用户所有，容器写 /app/langflow/secret_key
# 会 Permission denied，容器起不来。这里把属主对齐到镜像内 UID，是唯一不依赖宿主组的做法。
if [ "$(id -u)" = "0" ]; then
    chown -R 1000:0 "${DATA_DIR}" 2>/dev/null || true
else
    # 无 root 权限时退化为「全员可写」，至少保证容器内能落盘
    chmod -R 777 "${DATA_DIR}" 2>/dev/null || true
fi

echo "Prepared application data directory: ${DATA_DIR}"

exit 0
