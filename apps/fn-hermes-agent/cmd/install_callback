# 写入 .env 中的一个变量：更新已有的有效/注释模板行，否则追加新行。
# 通过 awk 的 ENVIRON 传值，避免 URL 中的 &, | 等字符破坏 sed 表达式。
set_env_value() {
    local env_file="$1"
    local env_name="$2"
    local env_value="$3"
    local temp_file

    [ -n "$env_name" ] || return 0
    case "$env_name" in
        [A-Z_][A-Z0-9_]*) ;;
        *) log_msg "Skipping invalid environment variable name: $env_name"; return 1 ;;
    esac

    temp_file=$(mktemp "${env_file}.tmp.XXXXXX")
    if ! ENV_NAME="$env_name" ENV_VALUE="$env_value" awk '
        BEGIN { found = 0 }
        {
            pattern = "^[[:space:]]*#?[[:space:]]*" ENVIRON["ENV_NAME"] "="
            if ($0 ~ pattern) {
                print ENVIRON["ENV_NAME"] "=" ENVIRON["ENV_VALUE"]
                found = 1
            } else {
                print
            }
        }
        END {
            if (!found) print ENVIRON["ENV_NAME"] "=" ENVIRON["ENV_VALUE"]
        }
    ' "$env_file" > "$temp_file"; then
        rm -f "$temp_file"
        return 1
    fi
    mv "$temp_file" "$env_file"
}

setup_hermes_home() {
    log_msg "Creating HERMES_HOME directories..."
    mkdir -p "${HERMES_HOME}"/{cron,sessions,logs,pairing,hooks,image_cache,audio_cache,memories,skills}

    # 复制配置模板
    if [ ! -f "${HERMES_HOME}/.env" ]; then
        if [ -f "${HERMES_REPO}/.env.example" ]; then
            cp "${HERMES_REPO}/.env.example" "${HERMES_HOME}/.env"
            log_msg "Created .env from template"
        else
            touch "${HERMES_HOME}/.env"
            log_msg "Created empty .env"
        fi
    else
        log_msg ".env already exists, keeping it"
    fi
    # 限制 .env 权限 — 该文件包含 API 密钥和令牌
    chmod 600 "${HERMES_HOME}/.env"

    # 仅在向导字段非空时覆盖对应环境变量；空值不会清空 .env 中已有配置。
    get_provider_env_vars "${wizard_provider_type:-dashscope}"
    if [ -n "${wizard_provider_url:-}" ] && [ -n "$WIZARD_PROVIDER_URL_ENV" ]; then
        set_env_value "${HERMES_HOME}/.env" "$WIZARD_PROVIDER_URL_ENV" "$wizard_provider_url"
        log_msg "$WIZARD_PROVIDER_URL_ENV written to .env"
    fi
    if [ -n "${wizard_provider_key:-}" ] && [ -n "$WIZARD_PROVIDER_KEY_ENV" ]; then
        set_env_value "${HERMES_HOME}/.env" "$WIZARD_PROVIDER_KEY_ENV" "$wizard_provider_key"
        log_msg "$WIZARD_PROVIDER_KEY_ENV written to .env"
    fi

    if [ ! -f "${HERMES_HOME}/config.yaml" ]; then
        if [ -f "${HERMES_REPO}/cli-config.yaml.example" ]; then
            cp "${HERMES_REPO}/cli-config.yaml.example" "${HERMES_HOME}/config.yaml"
            log_msg "Created config.yaml from template"
        fi
    fi

    # 创建 SOUL.md（全局人格文件）
    if [ ! -f "${HERMES_HOME}/SOUL.md" ]; then
        cat > "${HERMES_HOME}/SOUL.md" << 'SOUL_EOF'
You are Hermes Agent, an intelligent AI assistant created by Nous Research. You are helpful, knowledgeable, and direct. You assist users with a wide range of tasks including answering questions, writing and editing code, analyzing information, creative work, and executing actions via your tools. You communicate clearly, admit uncertainty when appropriate, and prioritize being genuinely useful over being verbose unless otherwise directed below. Be targeted and efficient in your exploration and investigations.
SOUL_EOF
        log_msg "Created SOUL.md (edit to customize personality)"
    fi

    # 同步内置技能到 ~/.hermes/skills/
    log_msg "Syncing bundled skills to ~/.hermes/skills/ ..."
    if "${HERMES_VENV}/bin/python" "${HERMES_REPO}/tools/skills_sync.py" 2>/dev/null; then
        log_msg "Skills synced to ~/.hermes/skills/"
    else
        # 回退：如果 Python 同步失败，直接复制目录
        if [ -d "${HERMES_REPO}/skills" ] && [ ! "$(ls -A "${HERMES_HOME}/skills/" 2>/dev/null | grep -v '.bundled_manifest')" ]; then
            cp -r "${HERMES_REPO}/skills/"* "${HERMES_HOME}/skills/" 2>/dev/null || true
            log_msg "Skills copied to ~/.hermes/skills/"
        fi
    fi
}

# ── 主流程 ────────────────────────────────────────────────

main() {
    ensure_node_runtime
    check_git
    clone_repo
    setup_venv
    install_deps
    install_node_deps
    setup_cli_wrapper
    setup_bash_profile
    setup_hermes_home
    log_msg "Installation complete."
}

main
exit 0
