#!/bin/bash
#
# install_callback — hermes-agent 安装后执行
# 从 install.sh 裁剪适配，仅保留 Debian x86 路径，消除所有交互
#
set -e

# ── 路径定义 ──────────────────────────────────────────────

APP_DIR="${TRIM_APPDEST}/app"
HERMES_REPO="${APP_DIR}/hermes-agent"
HERMES_VENV="${APP_DIR}/venv"
APP_BIN="${APP_DIR}/bin"
HERMES_HOME="${TRIM_APPDEST_VOL}/@appshare/fn-hermes-agent/.hermes"
REPO_URL="https://github.com/NousResearch/hermes-agent.git"
REPO_URL_SSH="git@github.com:NousResearch/hermes-agent.git"
BRANCH="main"
NODE_VERSION="v22.22.0"
NVM_DIR="/var/apps/fn-nvm/home/.nvm"
NODE_HOME="${NVM_DIR}/versions/node/${NODE_VERSION}"

# ── 运行时 PATH ──────────────────────────────────────────

export PATH="/var/apps/python311/target/bin:${NODE_HOME}/bin:/var/apps/fn-uv/target/bin:${PATH}"
export HOME="${TRIM_PKGHOME}"
export UV_NO_CONFIG=1

# ── 工具函数 ──────────────────────────────────────────────

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >&2
}

fail_install() {
    echo "$1" > "$TRIM_TEMP_LOGFILE"
    log_msg "ERROR: $1"
    exit 1
}

# fn-nvm 和 Node.js 数据由 UID 1000 用户管理。生命周期回调虽然以 root
# 执行，但不能以 root 写入 NVM 目录或执行 nvm install。
UID1000_ENTRY="$(getent passwd 1000 2>/dev/null || true)"
if [ -z "$UID1000_ENTRY" ]; then
    fail_install "Unable to find the passwd entry for UID 1000"
fi
IFS=: read -r UID1000_USER _ UID1000_UID UID1000_GID _ UID1000_HOME UID1000_SHELL <<EOF
$UID1000_ENTRY
EOF
if [ -z "$UID1000_USER" ] || [ -z "$UID1000_HOME" ] || [ ! -d "$UID1000_HOME" ]; then
    fail_install "Unable to resolve the home directory for UID 1000"
fi

run_as_uid1000() {
    if [ "$(id -u)" -eq "$UID1000_UID" ]; then
        HOME="$UID1000_HOME" USER="$UID1000_USER" LOGNAME="$UID1000_USER" \
            SHELL="$UID1000_SHELL" NVM_DIR="$NVM_DIR" "$@"
        return
    fi

    command -v runuser >/dev/null 2>&1 || fail_install "runuser is required to manage Node.js as UID 1000"
    runuser -u "$UID1000_USER" -- env \
        HOME="$UID1000_HOME" USER="$UID1000_USER" LOGNAME="$UID1000_USER" \
        SHELL="$UID1000_SHELL" NVM_DIR="$NVM_DIR" "$@"
}

ensure_node_runtime() {
    if [ -d "$NODE_HOME" ]; then
        log_msg "Node.js $NODE_VERSION already exists at $NODE_HOME"
        return 0
    fi

    [ -s "$NVM_DIR/nvm.sh" ] || fail_install "NVM is not installed at $NVM_DIR"
    log_msg "Node.js $NODE_VERSION not found, installing with fn-nvm as UID 1000..."
    if ! run_as_uid1000 bash -c '
        set -e
        . "$NVM_DIR/nvm.sh"
        nvm install "$1"
    ' bash "$NODE_VERSION"; then
        fail_install "Failed to install Node.js $NODE_VERSION with fn-nvm"
    fi

    [ -d "$NODE_HOME" ] || fail_install "Node.js $NODE_VERSION was not created at $NODE_HOME"
    log_msg "Node.js $NODE_VERSION installed at $NODE_HOME"
}

# ── 功能函数 ──────────────────────────────────────────────

check_git() {
    log_msg "Checking git..."
    if ! command -v git &>/dev/null; then
        log_msg "git not found, installing via apt..."
        DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1 || true
        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq git >/dev/null 2>&1 \
            || fail_install "Failed to install git"
    fi
    log_msg "git $(git --version | awk '{print $3}') ready"
}

# npm 在本地构建时会非确定性地重写 package-lock.json，这些差异通常是运行时
# 产生的无意义变更，不是用户的有意编辑。在 stash 前丢弃这些变更。
# 如果同一目录的 package.json 也有变更，则保留 lockfile 变更。
discard_update_lockfile_churn() {
    local repo="${1:-$HERMES_REPO}"
    [ -n "$repo" ] && [ -d "$repo/.git" ] || return 0
    command -v git >/dev/null 2>&1 || return 0

    local dirty_diff
    dirty_diff=$(git -C "$repo" diff --name-only 2>/dev/null) || return 0
    [ -n "$dirty_diff" ] || return 0

    # 收集有变更的 package.json 所在目录
    local dirty_package_dirs=""
    while IFS= read -r path; do
        case "$path" in
            *package.json)
                dirty_package_dirs="${dirty_package_dirs}$(dirname "$path")"$'\n'
                ;;
        esac
    done <<EOF
$dirty_diff
EOF

    # 找出只有 lockfile 变更（package.json 无变更）的文件
    local dirty_locks=""
    local dirty_count=0
    while IFS= read -r path; do
        case "$path" in
            *package-lock.json)
                local lock_dir
                lock_dir=$(dirname "$path")
                case $'\n'"$dirty_package_dirs" in
                    *$'\n'"$lock_dir"$'\n'*) continue ;;
                esac
                dirty_locks="${dirty_locks}${path}"$'\n'
                dirty_count=$((dirty_count + 1))
                ;;
        esac
    done <<EOF
$dirty_diff
EOF

    [ "$dirty_count" -gt 0 ] || return 0
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        git -C "$repo" checkout -- "$path" 2>/dev/null || true
    done <<EOF
$dirty_locks
EOF
    log_msg "Discarded npm lockfile churn (${dirty_count} file(s))"
}

clone_repo() {
    mkdir -p "$APP_DIR"

    # 处理中断的克隆（无 commit 的情况）
    if [ -d "$HERMES_REPO/.git" ] && ! git -C "$HERMES_REPO" rev-parse --verify HEAD >/dev/null 2>&1; then
        backup_dir="${HERMES_REPO}.broken-$(date -u +%Y%m%d-%H%M%S)"
        log_msg "Existing checkout has no commits (interrupted clone), moving to $backup_dir"
        mv "$HERMES_REPO" "$backup_dir"
    fi

    if [ -d "$HERMES_REPO" ]; then
        if [ -d "$HERMES_REPO/.git" ]; then
            log_msg "Updating existing repo at $HERMES_REPO ..."
            cd "$HERMES_REPO"

            # 丢弃 npm lockfile 的无意义变更
            discard_update_lockfile_churn

            # 暂存本地修改（非交互，不恢复）
            if [ -n "$(git status --porcelain)" ]; then
                # 清除之前冲突留下的未合并索引
                if [ -n "$(git ls-files --unmerged)" ]; then
                    log_msg "Clearing unmerged index entries..."
                    git reset -q
                fi
                local stash_name
                stash_name="hermes-install-$(date -u +%Y%m%d-%H%M%S)"
                log_msg "Local changes detected, stashing (not restoring)..."
                git stash push --include-untracked -m "$stash_name"
            fi

            # 只 fetch 目标分支，避免下载数千个自动生成的分支
            git remote set-branches origin "$BRANCH" 2>/dev/null || true
            git fetch origin "$BRANCH" || fail_install "git fetch failed"
            git checkout "$BRANCH" || fail_install "git checkout failed"

            # 先尝试 fast-forward，失败则 reset --hard
            if ! git pull --ff-only origin "$BRANCH" 2>/dev/null; then
                log_msg "Fast-forward not possible, resetting to origin/$BRANCH..."
                git reset --hard "origin/$BRANCH" || fail_install "git reset failed"
            fi
        else
            fail_install "Directory exists but is not a git repository: $HERMES_REPO"
        fi
    else
        # 先尝试 SSH（用于私有仓库），失败则用 HTTPS
        log_msg "Cloning hermes-agent ($BRANCH)..."
        log_msg "Trying SSH clone..."
        if GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=5" \
           git clone --depth 1 --branch "$BRANCH" "$REPO_URL_SSH" "$HERMES_REPO" 2>/dev/null; then
            log_msg "Cloned via SSH"
        else
            rm -rf "$HERMES_REPO" 2>/dev/null
            log_msg "SSH failed, trying HTTPS..."
            git clone --depth 1 --branch "$BRANCH" "$REPO_URL" "$HERMES_REPO" \
                || fail_install "git clone failed"
            log_msg "Cloned via HTTPS"
        fi
    fi

    cd "$HERMES_REPO"
    log_msg "Repository ready at $HERMES_REPO"
}

setup_venv() {
    log_msg "Creating venv with Python 3.11..."
    if [ ! -d "$HERMES_VENV" ]; then
        uv venv "$HERMES_VENV" --python 3.11 \
            || fail_install "Failed to create venv"
    fi
    log_msg "venv ready at $HERMES_VENV"
    export VIRTUAL_ENV="$HERMES_VENV"
    # 锁定 Python 解释器，防止 UV_PYTHON 环境变量干扰
    export UV_PYTHON="$HERMES_VENV/bin/python"
}

install_deps() {
    log_msg "Installing hermes-agent Python packages..."
    # ── 多层安装策略（移植自 install.sh）──────────────────────
    # Tier 0: uv sync --locked（uv.lock 哈希校验，依赖完整性有保障）
    # Tier 1: uv pip install .[all]（PyPI 重新解析，无哈希校验）
    # Tier 2: uv pip install .[all] 去掉已知损坏的 extras
    # Tier 3: uv pip install .（仅核心包，最后手段）

    local _installed=false

    # Tier 0: uv.lock 哈希校验
    if [ -f "uv.lock" ]; then
        log_msg "Tier 0: trying hash-verified install (uv.lock)..."
        if UV_PROJECT_ENVIRONMENT="$HERMES_VENV" uv sync --extra all --locked >&2; then
            log_msg "Tier 0 succeeded (hash-verified via uv.lock)"
            _installed=true
        else
            log_msg "Tier 0 failed, falling back to PyPI resolve..."
        fi
    fi

    # Tier 1: .[all]
    if [ "$_installed" = false ]; then
        log_msg "Tier 1: trying uv pip install -e '.[all]'..."
        if uv pip install -e '.[all]' >&2; then
            log_msg "Tier 1 succeeded (.\[all\])"
            _installed=true
        fi
    fi

    # Tier 2: 解析 pyproject.toml 中 [all] extras，排除已知损坏项
    if [ "$_installed" = false ]; then
        log_msg "Tier 2: trying safe extras..."
        local _ALL_EXTRAS_CSV="$(
            "$HERMES_VENV/bin/python" - <<'PY' 2>/dev/null
import re, sys
try:
    import tomllib
except ImportError:
    import tomli as tomllib
try:
    with open("pyproject.toml", "rb") as fh:
        data = tomllib.load(fh)
    specs = data["project"]["optional-dependencies"]["all"]
    extras = []
    for s in specs:
        m = re.search(r"hermes-agent\[([\w-]+)\]", s)
        if m:
            extras.append(m.group(1))
    print(",".join(extras))
except Exception:
    sys.exit(1)
PY
        )" || true

        local _BROKEN_EXTRAS=()
        local _SAFE_SPEC=".[all]"
        if [ -n "$_ALL_EXTRAS_CSV" ] && [ "${#_BROKEN_EXTRAS[@]}" -gt 0 ]; then
            IFS=',' read -ra _ALL_EXTRAS_ARR <<< "$_ALL_EXTRAS_CSV"
            local _SAFE_EXTRAS=()
            for _e in "${_ALL_EXTRAS_ARR[@]}"; do
                local _skip=false
                for _b in "${_BROKEN_EXTRAS[@]}"; do
                    [ "$_e" = "$_b" ] && { _skip=true; break; }
                done
                [ "$_skip" = false ] && _SAFE_EXTRAS+=("$_e")
            done
            _SAFE_SPEC=".[$(IFS=,; echo "${_SAFE_EXTRAS[*]}")]"
        fi

        if uv pip install -e "$_SAFE_SPEC" >&2; then
            log_msg "Tier 2 succeeded ($_SAFE_SPEC)"
            _installed=true
        fi
    fi

    # Tier 3: 仅核心包
    if [ "$_installed" = false ]; then
        log_msg "Tier 3: trying core only..."
        if uv pip install -e '.' >&2; then
            log_msg "Tier 3 succeeded (core only, some features may be missing)"
            _installed=true
        fi
    fi

    [ "$_installed" = false ] && fail_install "All install tiers failed"
    log_msg "Python packages installed"
}

install_node_deps() {
    if [ -f "package.json" ] && command -v node &>/dev/null; then
        log_msg "Installing Node.js dependencies..."
        npm install --silent >&2 || log_msg "npm install failed (non-fatal)"

        # Playwright Chromium（带超时，失败不阻塞）
        if [ -f "node_modules/.bin/playwright" ]; then
            log_msg "Installing Playwright Chromium (timeout 300s)..."
            timeout 300 npx playwright install chromium >&2 \
                || log_msg "Playwright install skipped or timed out (non-fatal)"
        fi
    fi
}

