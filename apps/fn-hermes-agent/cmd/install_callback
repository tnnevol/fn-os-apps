setup_bash_profile() {
    local profile="${TRIM_PKGHOME}/.bash_profile"
    if [ -f "$profile" ]; then
        log_msg ".bash_profile already exists, skipping"
        return 0
    fi
    log_msg "Creating .bash_profile..."
    cat > "$profile" << 'PROFILE_EOF'
export PATH="\${PATH}"
PROFILE_EOF
    log_msg ".bash_profile created at $profile"
}

