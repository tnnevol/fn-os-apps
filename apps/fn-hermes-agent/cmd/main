#!/bin/bash

PID_FILE="${TRIM_PKGVAR}/gateway.pid"
APP_BIN="${TRIM_APPDEST}/app/bin"
HERMES_REPO="${TRIM_APPDEST}/app/hermes-agent"
HERMES_VENV="${TRIM_APPDEST}/app/venv"
HERMES_HOME="${TRIM_APPDEST_VOL}/@appshare/fn-hermes-agent/.hermes"

# ── 工具函数 ────────────────────────────────────────────────────

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >&2
}

check_process() {
    local pid="$1"
    kill -0 "$pid" 2>/dev/null
}

status_app() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
        if [ -n "$pid" ] && check_process "$pid"; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

start_app() {
    if status_app; then
        return 0
    fi
    # 修复目录权限，防止用户以 root 操作后权限被覆盖
    log_msg "Fixing ownership for $TRIM_USERNAME:$TRIM_GROUPNAME..."
    chown -R "$TRIM_USERNAME:$TRIM_GROUPNAME" \
        "${TRIM_APPDEST}" \
        "${TRIM_PKGVAR}" \
        "${TRIM_PKGHOME}" \
        "${TRIM_APPDEST_VOL}/@appshare/fn-hermes-agent" \
        2>/dev/null || true
    log_msg "Starting hermes gateway as $TRIM_USERNAME..."
    runuser -u "$TRIM_USERNAME" -- "${APP_BIN}/hermes" gateway &
    echo "$!" > "$PID_FILE"
    log_msg "hermes gateway started (PID $!)"
}

stop_app() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"

    if [ -z "$pid" ] || ! check_process "$pid"; then
        rm -f "$PID_FILE"
        return 0
    fi

    log_msg "Stopping hermes gateway (PID $pid)..."
    kill -TERM "$pid" 2>/dev/null || true

    local count=0
    while check_process "$pid" && [ "$count" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "$pid"; then
        kill -KILL "$pid" 2>/dev/null || true
        sleep 1
    fi

    rm -f "$PID_FILE"
    log_msg "hermes gateway stopped"
}

case "$1" in
start)
    start_app
    ;;
stop)
    stop_app
    ;;
status)
    if status_app; then
        exit 0
    fi
    exit 3
    ;;
*)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
