#!/bin/bash

APP_BIN="${TRIM_APPDEST}/app/bin"
HERMES_CLI="${APP_BIN}/hermes"
HERMES_REPO="${TRIM_APPDEST}/app/hermes-agent"
HERMES_VENV="${TRIM_APPDEST}/app/venv"
HERMES_HOME="${TRIM_APPDEST_VOL}/@appshare/fn-hermes-agent/.hermes"

# gateway
GATEWAY_CMD="${HERMES_CLI} gateway run"
GATEWAY_STOP_CMD="${HERMES_CLI} gateway stop"
GATEWAY_STATUS_CMD="${HERMES_CLI} gateway status"

# dashboard
DASHBOARD_CMD="${HERMES_CLI} dashboard --no-open --host $dashboard_host --port $dashboard_port"
DASHBOARD_STOP_CMD="${HERMES_CLI} dashboard --stop"
DASHBOARD_STATUS_CMD="${HERMES_CLI} dashboard --status"


# 获取 NAS 主用户（UID 1000），不存在则回退到应用专用用户
if id -u 1000 &>/dev/null; then
    NAS_MAIN_USER=$(id -un 1000)
    NAS_MAIN_GROUP=$(id -gn 1000)
else
    NAS_MAIN_USER="$TRIM_USERNAME"
    NAS_MAIN_GROUP="$TRIM_GROUPNAME"
fi


# ── 工具函数 ────────────────────────────────────────────────────

# log_msg <前缀> <消息>
log_msg() {
    local prefix="$1"
    local msg="$2"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [$prefix] $msg" >&2
}

# 检查 gateway 是否运行中（通过 hermes CLI 查询真实状态，不维护 pid 文件）。
# 未运行输出形如 "✗ Gateway is not running"，运行中为 "✓ Gateway is running (PID: ...)"
gateway_running() {
    ! runuser -u "$NAS_MAIN_USER" -- $GATEWAY_STATUS_CMD 2>/dev/null | grep -q "Gateway is not running"
}

# 检查 dashboard 是否运行中。
# 运行中输出形如 "2 hermes dashboard process(es) running:"，未运行为 "No hermes dashboard processes running."
dashboard_running() {
    runuser -u "$NAS_MAIN_USER" -- $DASHBOARD_STATUS_CMD 2>/dev/null | grep -qE '^[0-9]+ hermes dashboard'
}

# 启动进程：start_process <名称> <命令...>
start_process() {
    local name="$1"
    local component="${name##hermes }"  # 提取 gateway 或 dashboard
    shift
    log_msg "$component" "Starting $name as $NAS_MAIN_USER..."
    runuser -u "$NAS_MAIN_USER" -- "$@" &
    log_msg "$component" "$name started"
}

# 停止进程：stop_process <名称> <状态检查函数> <停止命令...>
# 使用 hermes 优雅停止命令，再通过状态检查函数等待退出
# 返回：0=成功停止或原本未运行，1=停止失败（超时仍在运行）
stop_process() {
    local name="$1"
    local check_fn="$2"
    local component="${name##hermes }"  # 提取 gateway 或 dashboard
    shift 2

    # 优雅停止（以 NAS 主用户执行 hermes 停止子命令）
    log_msg "$component" "Stopping $name gracefully..."
    runuser -u "$NAS_MAIN_USER" -- "$@" >/dev/null 2>&1 || true

    # 通过 CLI 真实状态等待进程退出
    local count=0
    while "$check_fn" && [ "$count" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done
    if "$check_fn"; then
        log_msg "$component" "$name stop failed (still running)"
        return 1
    fi
    log_msg "$component" "$name stopped"
    return 0
}

# 清理残留的 dashboard 进程（如 hermes update 仅重启 gateway 时残留），
# 避免重新启动时端口被占用
cleanup_stale_dashboard() {
    if dashboard_running; then
        stop_process "hermes dashboard" dashboard_running $DASHBOARD_STOP_CMD || true
    fi
}

status_app() {
    # 以 gateway 为主进程，通过 hermes CLI 查询真实状态，不依赖 pid 文件：
    # dashboard 内部更新会后台重启 gateway 导致 PID 变化，
    # 基于 pid 文件判断会误判为已停止，使框架进入假停用状态
    if gateway_running; then
        return 0
    fi
    # gateway 未运行时，同步停止残留的 dashboard
    cleanup_stale_dashboard
    return 1
}

# 修复目录权限，防止用户以 root 执行 hermes CLI 后权限被覆盖
fix_ownership() {
    # 启动前修复权限
    log_msg "main" "Fixing ownership for $NAS_MAIN_USER:$NAS_MAIN_GROUP..."
    chown -R "$NAS_MAIN_USER:$NAS_MAIN_GROUP" \
        "${TRIM_APPDEST}" \
        "${TRIM_PKGVAR}" \
        "${TRIM_PKGHOME}" \
        "${TRIM_APPDEST_VOL}/@appshare/fn-hermes-agent" \
        2>/dev/null || true
}

start_app() {
    fix_ownership
    # status_app 在 gateway 未运行时已同步清理残留 dashboard
    if status_app; then
        # gateway 已运行，但 dashboard 可能单独挂掉，补启动
        if ! dashboard_running; then
            start_process "hermes dashboard" $DASHBOARD_CMD
        fi
        return 0
    fi
    # 启动 gateway
    start_process "hermes gateway" $GATEWAY_CMD
    # 启动 dashboard
    start_process "hermes dashboard" $DASHBOARD_CMD
}

stop_app() {
    local result=0
    stop_process "hermes gateway" gateway_running $GATEWAY_STOP_CMD || result=1
    stop_process "hermes dashboard" dashboard_running $DASHBOARD_STOP_CMD || result=1
    return $result
}

case "$1" in
start)
    start_app
    ;;
stop)
    stop_app
    ;;
status)
    if status_app; then
        exit 0
    fi
    exit 3
    ;;
*)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
