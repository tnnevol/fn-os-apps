#!/bin/bash

PID_FILE="${TRIM_PKGVAR}/gateway.pid"
PID_DASHBOARD="${TRIM_PKGVAR}/dashboard.pid"
APP_BIN="${TRIM_APPDEST}/app/bin"
HERMES_CLI="${APP_BIN}/hermes"
HERMES_REPO="${TRIM_APPDEST}/app/hermes-agent"
HERMES_VENV="${TRIM_APPDEST}/app/venv"
HERMES_HOME="${TRIM_APPDEST_VOL}/@appshare/fn-hermes-agent/.hermes"

GATEWAY_CMD="${HERMES_CLI} gateway"
DASHBOARD_CMD="${HERMES_CLI} dashboard --no-open --host $dashboard_host --port $dashboard_port"


# ── 工具函数 ────────────────────────────────────────────────────

# log_msg <前缀> <消息>
log_msg() {
    local prefix="$1"
    local msg="$2"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [$prefix] $msg" >&2
}

check_process() {
    local pid="$1"
    kill -0 "$pid" 2>/dev/null
}

# 启动进程：start_process <名称> <pid_file> <命令...>
start_process() {
    local name="$1"
    local pid_file="$2"
    local component="${name##hermes }"  # 提取 gateway 或 dashboard
    shift 2
    log_msg "$component" "Starting $name as uid $TRIM_UID..."
    runuser -u "$TRIM_UID" -- "$@" &
    echo "$!" > "$pid_file"
    log_msg "$component" "$name started (PID $!)"
}

# 停止进程：stop_process <名称> <pid_file>
# 返回：0=成功停止或原本未运行，1=停止失败
stop_process() {
    local name="$1"
    local pid_file="$2"
    local component="${name##hermes }"  # 提取 gateway 或 dashboard
    if [ -f "$pid_file" ]; then
        local pid
        pid="$(head -n 1 "$pid_file" | tr -d '[:space:]')"
        if [ -n "$pid" ] && check_process "$pid"; then
            log_msg "$component" "Stopping $name (PID $pid)..."
            kill -TERM "$pid" 2>/dev/null || true
            local count=0
            while check_process "$pid" && [ "$count" -lt 10 ]; do
                sleep 1
                count=$((count + 1))
            done
            if check_process "$pid"; then
                kill -KILL "$pid" 2>/dev/null || true
                sleep 1
            fi
            if check_process "$pid"; then
                log_msg "$component" "$name stop failed (PID $pid still running)"
                rm -f "$pid_file"
                return 1
            fi
            log_msg "$component" "$name stopped"
        fi
        rm -f "$pid_file"
    fi
    return 0
}

status_app() {
    # 以 gateway 为主进程，只检查 gateway 状态
    if [ -f "$PID_FILE" ]; then
        local pid
        pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
        if [ -n "$pid" ] && check_process "$pid"; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

# 修复目录权限，防止用户以 root 执行 hermes CLI 后权限被覆盖
fix_ownership() {
    # 启动前修复权限
    log_msg "main" "Fixing ownership for $TRIM_UID:$TRIM_GID..."
    chown -R "$TRIM_UID:$TRIM_GID" \
        "${TRIM_APPDEST}" \
        "${TRIM_PKGVAR}" \
        "${TRIM_PKGHOME}" \
        "${TRIM_APPDEST_VOL}/@appshare/fn-hermes-agent" \
        2>/dev/null || true
}

start_app() {
    if status_app; then
        return 0
    fi
    fix_ownership
    # 启动 gateway
    start_process "hermes gateway" "$PID_FILE" $GATEWAY_CMD
    # 启动 dashboard
    start_process "hermes dashboard" "$PID_DASHBOARD" $DASHBOARD_CMD
}

stop_app() {
    local result=0
    stop_process "hermes gateway" "$PID_FILE" || result=1
    stop_process "hermes dashboard" "$PID_DASHBOARD" || result=1
    return $result
}

case "$1" in
start)
    start_app
    ;;
stop)
    stop_app
    ;;
status)
    # 轮询时定期修复权限
    fix_ownership
    if status_app; then
        exit 0
    fi
    exit 3
    ;;
*)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
