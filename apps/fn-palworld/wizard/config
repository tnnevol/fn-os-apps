[
  {
    "stepTitle": "游戏端口",
    "items": [
      {
        "type": "tips",
        "helpText": "Palworld Server 不提供网页界面，需要用游戏客户端或 RCON 工具连接。安装后请在应用中心确认应用已启动，再从客户端连接。"
      },
      {
        "type": "text",
        "field": "GAME_PORT",
        "label": "游戏联机端口",
        "initValue": "8211",
        "helpText": "游戏客户端连接使用的 UDP 端口（映射到容器内 8211）。对外服务时应填这台 NAS 实际使用的端口。",
        "rules": [
          { "required": true, "message": "请输入端口号" },
          {
            "pattern": "^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
            "message": "端口号必须是 1—65535 之间的整数"
          }
        ]
      },
      {
        "type": "text",
        "field": "QUERY_PORT",
        "label": "查询端口",
        "initValue": "27015",
        "helpText": "Steam 查询端口，固定映射容器内 27015（客户端硬编码）。若与 NAS 上已有服务冲突，请修改左侧的对外端口。",
        "rules": [
          { "required": true, "message": "请输入端口号" },
          {
            "pattern": "^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
            "message": "端口号必须是 1—65535 之间的整数"
          }
        ]
      }
    ]
  },
