#!/bin/bash

# This entrypoint is linked by fnOS into /usr/local/bin. Keep all runtime
# locations here fixed so a caller cannot redirect DSH to another profile.
set -euo pipefail

PACKAGE_ID="fn-deepseek-harness"
PACKAGE_ROOT="/var/packages/${PACKAGE_ID}"
DSH_HOME="${PACKAGE_ROOT}/home"
NPM_PREFIX="${DSH_HOME}/.npm-global"
NODE_BIN="/var/apps/nodejs_v24/target/bin"
REAL_DSH="${NPM_PREFIX}/bin/dsh"
ENV_BIN="/usr/bin/env"
STAT_BIN="/usr/bin/stat"
ID_BIN="/usr/bin/id"

[ -x "${ENV_BIN}" ] && [ -x "${STAT_BIN}" ] && [ -x "${ID_BIN}" ] || {
    printf '%s\n' 'dsh: required system utilities are unavailable' >&2
    exit 1
}

[ -d "${DSH_HOME}" ] || { printf '%s\n' 'dsh: application home is unavailable' >&2; exit 1; }
[ -x "${REAL_DSH}" ] || { printf '%s\n' 'dsh: the fixed DSH runtime is not installed' >&2; exit 1; }
[ -x "${NODE_BIN}/node" ] || { printf '%s\n' 'dsh: nodejs_v24 runtime is unavailable' >&2; exit 1; }

APP_UID="$(${STAT_BIN} -c '%u' "${DSH_HOME}" 2>/dev/null || true)"
APP_GID="$(${STAT_BIN} -c '%g' "${DSH_HOME}" 2>/dev/null || true)"
case "${APP_UID}:${APP_GID}" in
    '' | *[!0-9:]* | 0:* | *:0)
        printf '%s\n' 'dsh: invalid application ownership' >&2
        exit 1
        ;;
esac
APP_USER="$(${ID_BIN} -nu "${APP_UID}" 2>/dev/null || true)"
APP_GROUP="$(${ID_BIN} -ng "${APP_UID}" 2>/dev/null || true)"
[ -n "${APP_USER}" ] && [ -n "${APP_GROUP}" ] || {
    printf '%s\n' 'dsh: application owner cannot be resolved' >&2
    exit 1
}
[ "$(${ID_BIN} -g "${APP_USER}" 2>/dev/null || true)" = "${APP_GID}" ] || {
    printf '%s\n' 'dsh: application owner/group mismatch' >&2
    exit 1
}

exec_as_app_user() {
    "${ENV_BIN}" -i \
        HOME="${DSH_HOME}" \
        DSH_HOME="${DSH_HOME}" \
        NPM_CONFIG_CACHE="${DSH_HOME}/.npm-cache" \
        NPM_CONFIG_PREFIX="${NPM_PREFIX}" \
        NPM_CONFIG_USERCONFIG="${DSH_HOME}/.npmrc" \
        XDG_CONFIG_HOME="${DSH_HOME}/.config" \
        PATH="${NODE_BIN}:${NPM_PREFIX}/bin:/usr/bin:/bin" \
        "${REAL_DSH}" "$@"
}

if [ "$(${ID_BIN} -u)" = "${APP_UID}" ]; then
    [ "$(${ID_BIN} -g)" = "${APP_GID}" ] || {
        printf '%s\n' 'dsh: refusing to run with an unexpected group' >&2
        exit 1
    }
    exec_as_app_user "$@"
fi

RUNUSER=''
for candidate in /usr/sbin/runuser /usr/bin/runuser; do
    if [ -x "${candidate}" ]; then RUNUSER="${candidate}"; break; fi
done
[ -n "${RUNUSER}" ] || {
    printf '%s\n' 'dsh: secure application-user switch is unavailable' >&2
    exit 1
}
exec "${RUNUSER}" --user "${APP_USER}" --group "${APP_GROUP}" -- \
    "${ENV_BIN}" -i \
    HOME="${DSH_HOME}" \
    DSH_HOME="${DSH_HOME}" \
    NPM_CONFIG_CACHE="${DSH_HOME}/.npm-cache" \
    NPM_CONFIG_PREFIX="${NPM_PREFIX}" \
    NPM_CONFIG_USERCONFIG="${DSH_HOME}/.npmrc" \
    XDG_CONFIG_HOME="${DSH_HOME}/.config" \
    PATH="${NODE_BIN}:${NPM_PREFIX}/bin:/usr/bin:/bin" \
    "${REAL_DSH}" "$@"
