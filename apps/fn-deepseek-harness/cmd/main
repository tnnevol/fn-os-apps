#!/bin/bash

PID_FILE="${TRIM_PKGVAR}/app.pid"
GATEWAY_PID_FILE="${TRIM_PKGVAR}/gateway.pid"
DSH_HOME="${TRIM_PKGHOME}"
APP_HOME="${TRIM_APPDEST_VOL}/@appshare/fn-deepseek-harness"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"
PROXY_SCRIPT="${TRIM_APPDEST}/gateway-proxy.mjs"
COMPATIBILITY_SCRIPT="${TRIM_APPDEST}/scripts/prepare-dsh-compatibility.mjs"
FNOS_PLUGIN_SCRIPT="${TRIM_APPDEST}/scripts/install-dsh-fnos-plugin.mjs"
FNOS_PLUGIN_SOURCE="${TRIM_APPDEST}/plugins/dsh-fnos"
FNOS_PROFILE_DIRECTORY="${DSH_HOME}/profiles/web"
GATEWAY_PREFIX="/app/fn-deepseek-harness"
NODE_BIN="/var/apps/nodejs_v24/target/bin"
REQUESTED_HOST="${wizard_host:-127.0.0.1}"
PORT="${wizard_port:-3080}"
TRUSTED_HOSTS="${wizard_trusted_hosts:-}"
COMPATIBILITY_PATCH="${APP_HOME}/.fn-deepseek-harness/compatibility/web-incompatible-plugins.patch.yml"
DSH_BIN="${DSH_HOME}/.npm-global/bin/dsh"

case "${REQUESTED_HOST}" in
127.0.0.1|0.0.0.0)
    HOST="${REQUESTED_HOST}"
    ;;
*)
    # Existing installations may still have an older NAS IP value. The dsh
    # webserver only accepts these two bind addresses, so expose all interfaces
    # instead of passing an invalid host to dsh.
    HOST="0.0.0.0"
    ;;
esac

export PATH="${NODE_BIN}:${PATH}"
export DSH_HOME
export HOME="${APP_HOME}"
export NPM_CONFIG_CACHE="${DSH_HOME}/.npm-cache"
export NPM_CONFIG_PREFIX="${DSH_HOME}/.npm-global"
export PATH="${NPM_CONFIG_PREFIX}/bin:${PATH}"

log_error() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "$1" > "${TRIM_TEMP_LOGFILE}"
    fi
    echo "$1" >&2
}

check_process() {
    local pid="$1"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

prepare_dsh_compatibility() {
    [ -f "${COMPATIBILITY_SCRIPT}" ] || return 0
    DSH_COMPAT_PROFILE_DIRECTORY="${DSH_HOME}/profiles/web" \
    DSH_COMPAT_DSH_PACKAGE_DIRECTORY="${DSH_HOME}/.npm-global/lib/node_modules/@deepseek-ai/dsh" \
    DSH_COMPAT_DSH_PACKAGE_FILE="${DSH_HOME}/.npm-global/lib/node_modules/@deepseek-ai/dsh/package.json" \
    DSH_COMPAT_DSH_VERSION_FILE="${TRIM_APPDEST}/dsh-version" \
    DSH_COMPAT_APP_HOME="${APP_HOME}" \
    DSH_COMPAT_PATCH_FILE="${COMPATIBILITY_PATCH}" \
    "${NODE_BIN}/node" "${COMPATIBILITY_SCRIPT}"
}

prepare_bundled_fnos_plugin() {
    [ -f "${FNOS_PLUGIN_SCRIPT}" ] || return 0
    [ -f "${FNOS_PLUGIN_SOURCE}/package.json" ] || {
        log_error "Bundled fnOS DSH plugin is missing"
        return 1
    }

    if [ ! -f "${FNOS_PROFILE_DIRECTORY}/package.json" ]; then
        "${DSH_BIN}" --profile web --dump-config >/dev/null 2>&1 || {
            log_error "Unable to initialize the dsh web profile"
            return 1
        }
    fi

    DSH_FNOS_PLUGIN_SOURCE="${FNOS_PLUGIN_SOURCE}" \
    DSH_FNOS_PROFILE_DIRECTORY="${FNOS_PROFILE_DIRECTORY}" \
    "${NODE_BIN}/node" "${FNOS_PLUGIN_SCRIPT}"
}

pid_from_file() {
    local file="$1"
    [ -r "${file}" ] || return 0
    head -n 1 "${file}" | tr -d '[:space:]'
}

start_process() {
    if status; then
        return 0
    fi

    if [ ! -x "${NODE_BIN}/node" ]; then
        log_error "nodejs_v24 runtime is not available at ${NODE_BIN}"
        return 1
    fi

    if [ ! -x "${DSH_BIN}" ]; then
        log_error "dsh is not installed at ${DSH_BIN}; run the application install callback first"
        return 1
    fi

    if [ ! -f "${PROXY_SCRIPT}" ]; then
        log_error "DeepSeek Harness gateway proxy is not available at ${PROXY_SCRIPT}"
        return 1
    fi

    if [ "${HOST}" = "127.0.0.1" ] && [ -z "${TRUSTED_HOSTS}" ]; then
        log_error "No trusted NAS Web host configured; set the trusted access address to the NAS host or host:port in application settings"
        return 1
    fi

    mkdir -p "${DSH_HOME}/.npm-cache" "${HOME}"
    if ! prepare_bundled_fnos_plugin; then
        log_error "Unable to prepare the bundled fnOS DSH plugin; the application was not started"
        return 1
    fi
    if ! prepare_dsh_compatibility; then
        log_error "Unable to prepare DSH compatibility quarantine; the application was not started"
        return 1
    fi
    rm -f "${SOCKET_PATH}"
    echo "Starting DeepSeek Harness on ${HOST}:${PORT}..."

    (
        cd "${TRIM_APPDEST}" || exit 1
        GATEWAY_SOCKET="${SOCKET_PATH}" \
        GATEWAY_PREFIX="${GATEWAY_PREFIX}" \
        DSH_UPSTREAM_HOST="127.0.0.1" \
        DSH_UPSTREAM_PORT="${PORT}" \
        exec node "${PROXY_SCRIPT}"
    ) &
    printf "%s" "$!" > "${GATEWAY_PID_FILE}"

    local -a dsh_args=(web)
    if [ -f "${COMPATIBILITY_PATCH}" ]; then
        dsh_args+=(--patch "${COMPATIBILITY_PATCH}")
    fi
    dsh_args+=(--host "${HOST}" --port "${PORT}")
    if [ -n "${TRUSTED_HOSTS}" ]; then
        local -a trusted_host_list
        local trusted_host
        IFS=',' read -r -a trusted_host_list <<< "${TRUSTED_HOSTS}"
        for trusted_host in "${trusted_host_list[@]}"; do
            [ -n "${trusted_host}" ] || continue
            dsh_args+=(--trusted-host "${trusted_host}")
        done
    fi
    (
        cd "${TRIM_APPDEST}" || exit 1
        exec "${DSH_BIN}" "${dsh_args[@]}"
    ) &
    printf "%s" "$!" > "${PID_FILE}"
    return 0
}

stop_pid() {
    local pid_file="$1"
    if [ ! -r "${pid_file}" ]; then
        return 0
    fi

    local pid
    pid=$(pid_from_file "${pid_file}")
    if ! check_process "${pid}"; then
        rm -f "${pid_file}"
        return 0
    fi

    kill -TERM "${pid}" 2>/dev/null || true

    local count=0
    while check_process "${pid}" && [ "${count}" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "${pid}"; then
        kill -KILL "${pid}" 2>/dev/null || true
    fi
    rm -f "${pid_file}"
}

stop_process() {
    stop_pid "${PID_FILE}"
    stop_pid "${GATEWAY_PID_FILE}"
    rm -f "${SOCKET_PATH}"
    return 0
}

status() {
    local dsh_pid
    local gateway_pid
    dsh_pid=$(pid_from_file "${PID_FILE}")
    gateway_pid=$(pid_from_file "${GATEWAY_PID_FILE}")

    if check_process "${dsh_pid}" && check_process "${gateway_pid}"; then
        return 0
    fi

    [ -n "${dsh_pid}" ] || rm -f "${PID_FILE}"
    [ -n "${gateway_pid}" ] || rm -f "${GATEWAY_PID_FILE}"
    return 1
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
