#!/bin/bash

PID_FILE="${TRIM_PKGVAR}/app.pid"
GATEWAY_PID_FILE="${TRIM_PKGVAR}/gateway.pid"
DSH_HOME="${TRIM_PKGHOME}"
APP_HOME="${TRIM_APPDEST_VOL}/@appshare/fn-deepseek-harness"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"
PROXY_SCRIPT="${TRIM_APPDEST}/gateway-proxy.mjs"
GATEWAY_PREFIX="/app/fn-deepseek-harness"
NODE_BIN="/var/apps/nodejs_v24/target/bin"
REQUESTED_HOST="${wizard_host:-127.0.0.1}"
PORT="${wizard_port:-3080}"
TRUSTED_HOSTS="${wizard_trusted_hosts:-}"
DSH_BIN="${DSH_HOME}/.npm-global/bin/dsh"
HOST="${REQUESTED_HOST}"

export PATH="${NODE_BIN}:${PATH}"
export DSH_HOME
export HOME="${APP_HOME}"
export NPM_CONFIG_CACHE="${DSH_HOME}/.npm-cache"
export NPM_CONFIG_PREFIX="${DSH_HOME}/.npm-global"
export PATH="${NPM_CONFIG_PREFIX}/bin:${PATH}"

log_message() {
    local level="$1"
    shift
    printf '[%s] [main] [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${level}" "$*"
}

log_info() {
    log_message INFO "$@"
}

log_error() {
    log_message ERROR "$@" >&2
}

check_process() {
    local pid="$1"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

pid_from_file() {
    local file="$1"
    [ -r "${file}" ] || return 0
    head -n 1 "${file}" | tr -d '[:space:]'
}

start_process() {
    if status; then
        return 0
    fi

    rm -f "${SOCKET_PATH}"
    mkdir -p "${TRIM_PKGVAR}/gateway"
    log_info "Starting DeepSeek Harness on ${HOST}:${PORT}..."

    (
        cd "${TRIM_APPDEST}" || exit 1
        GATEWAY_SOCKET="${SOCKET_PATH}" \
            GATEWAY_PREFIX="${GATEWAY_PREFIX}" \
            GATEWAY_PATH_ALLOWLIST="${TRIM_PKGVAR}/gateway/path-allowlist.json" \
            DSH_UPSTREAM_HOST="127.0.0.1" \
            DSH_UPSTREAM_PORT="${PORT}" \
            DSH_BIN="${DSH_BIN}" \
            DSH_CWD="${TRIM_APPDEST}" \
            DSH_PID_FILE="${PID_FILE}" \
            DSH_START_LOCK_FILE="${TRIM_PKGVAR}/web-start.lock" \
            DSH_WEB_HOST="${HOST}" \
            DSH_TRUSTED_HOSTS="${TRUSTED_HOSTS}" \
            exec node "${PROXY_SCRIPT}"
    ) &
    printf "%s" "$!" >"${GATEWAY_PID_FILE}"
    return 0
}

stop_pid() {
    local pid_file="$1"
    if [ ! -r "${pid_file}" ]; then
        return 0
    fi

    local pid
    pid=$(pid_from_file "${pid_file}")
    if ! check_process "${pid}"; then
        rm -f "${pid_file}"
        return 0
    fi

    kill -TERM "${pid}" 2>/dev/null || true

    local count=0
    while check_process "${pid}" && [ "${count}" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "${pid}"; then
        kill -KILL "${pid}" 2>/dev/null || true
    fi
    rm -f "${pid_file}"
}

stop_process() {
    stop_pid "${GATEWAY_PID_FILE}"
    # The gateway normally terminates its DSH child. Keep this fallback for a
    # gateway crash during uninstall or package shutdown.
    stop_pid "${PID_FILE}"
    rm -f "${SOCKET_PATH}"
    return 0
}

status() {
    local gateway_pid
    gateway_pid=$(pid_from_file "${GATEWAY_PID_FILE}")

    if check_process "${gateway_pid}"; then
        return 0
    fi

    rm -f "${GATEWAY_PID_FILE}"
    return 1
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
