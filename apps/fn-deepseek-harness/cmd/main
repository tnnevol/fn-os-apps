#!/bin/bash

PID_FILE="${TRIM_PKGVAR}/app.pid"
GATEWAY_PID_FILE="${TRIM_PKGVAR}/gateway.pid"
RESTART_MARKER="${TRIM_PKGVAR}/internal-restart"
RESTART_GRACE_SECONDS=120
DSH_HOME="${TRIM_PKGHOME}"
APP_HOME="${TRIM_APPDEST_VOL}/@appshare/fn-deepseek-harness"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"
PROXY_SCRIPT="${TRIM_APPDEST}/gateway-proxy.mjs"
GATEWAY_PREFIX="/app/fn-deepseek-harness"
NODE_BIN="/var/apps/nodejs_v24/target/bin"
REQUESTED_HOST="${wizard_host:-127.0.0.1}"
PORT="${wizard_port:-3080}"
TRUSTED_HOSTS="${wizard_trusted_hosts:-}"
DSH_BIN="${DSH_HOME}/.npm-global/bin/dsh"
HOST="${REQUESTED_HOST}"

export PATH="${NODE_BIN}:${PATH}"
export DSH_HOME
export HOME="${APP_HOME}"
export NPM_CONFIG_CACHE="${DSH_HOME}/.npm-cache"
export NPM_CONFIG_PREFIX="${DSH_HOME}/.npm-global"
export PATH="${NPM_CONFIG_PREFIX}/bin:${PATH}"

log_message() {
    local level="$1"
    shift
    printf '[%s] [main] [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${level}" "$*"
}

log_info() {
    log_message INFO "$@"
}

log_error() {
    log_message ERROR "$@" >&2
}

check_process() {
    local pid="$1"
    [ -n "$pid" ] || return 1
    if [ -r "/proc/${pid}/stat" ]; then
        local state
        state=$(awk '{print $3}' "/proc/${pid}/stat" 2>/dev/null)
        case "${state}" in
        Z | X) return 1 ;;
        esac
    fi
    kill -0 "$pid" 2>/dev/null
}

pid_from_file() {
    local file="$1"
    [ -r "${file}" ] || return 0
    head -n 1 "${file}" | tr -d '[:space:]'
}

process_group_id() {
    local pid="$1"
    [ -r "/proc/${pid}/stat" ] || return 0
    awk '{ sub(/^.*\) /, ""); print $3 }' "/proc/${pid}/stat" 2>/dev/null
}

process_command_line() {
    local pid="$1"
    [ -r "/proc/${pid}/cmdline" ] || return 1
    tr '\0' ' ' <"/proc/${pid}/cmdline" 2>/dev/null
}

is_runtime_process() {
    local pid="$1"
    local kind="$2"
    local command_line
    command_line="$(process_command_line "${pid}")" || return 1

    case "${kind}" in
    gateway)
        case "${command_line}" in
        *"/fn-deepseek-harness/gateway-proxy.mjs"*) return 0 ;;
        esac
        ;;
    dsh)
        case "${command_line}" in
        *"${DSH_BIN}"*" web "*"--port ${PORT}"*) return 0 ;;
        esac
        ;;
    esac
    return 1
}

stop_runtime_pid() {
    local pid="$1"
    if ! check_process "${pid}"; then
        return 0
    fi

    local group_id
    group_id=$(process_group_id "${pid}")
    if [ "${group_id}" = "${pid}" ]; then
        kill -TERM -- "-${pid}" 2>/dev/null || true
    else
        kill -TERM "${pid}" 2>/dev/null || true
    fi

    local count=0
    while check_process "${pid}" && [ "${count}" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "${pid}"; then
        if [ "${group_id}" = "${pid}" ]; then
            kill -KILL -- "-${pid}" 2>/dev/null || true
        else
            kill -KILL "${pid}" 2>/dev/null || true
        fi
    fi
}

cleanup_orphaned_runtime_processes() {
    local entry pid
    for entry in /proc/[0-9]*; do
        pid="${entry##*/}"
        [ "${pid}" != "$$" ] || continue
        if is_runtime_process "${pid}" gateway; then
            log_info "Stopping orphaned fnOS gateway process ${pid}."
            stop_runtime_pid "${pid}"
            continue
        fi
        if is_runtime_process "${pid}" dsh; then
            log_info "Stopping orphaned DSH Web process ${pid}."
            stop_runtime_pid "${pid}"
        fi
    done
}

restart_in_progress() {
    [ -r "${RESTART_MARKER}" ] || return 1

    local started_at now elapsed
    started_at=$(head -n 1 "${RESTART_MARKER}" | tr -d '[:space:]')
    case "${started_at}" in
    '' | *[!0-9]*)
        rm -f "${RESTART_MARKER}"
        return 1
        ;;
    esac

    now=$(date +%s)
    elapsed=$((now - started_at))
    if [ "${elapsed}" -lt 0 ] || [ "${elapsed}" -gt "${RESTART_GRACE_SECONDS}" ]; then
        rm -f "${RESTART_MARKER}"
        return 1
    fi
    return 0
}

gateway_running() {
    local gateway_pid
    gateway_pid=$(pid_from_file "${GATEWAY_PID_FILE}")
    check_process "${gateway_pid}" && is_runtime_process "${gateway_pid}" gateway
}

dsh_running() {
    local dsh_pid
    dsh_pid=$(pid_from_file "${PID_FILE}")
    check_process "${dsh_pid}" && is_runtime_process "${dsh_pid}" dsh
}

start_process() {
    if gateway_running && dsh_running; then
        return 0
    fi

    if gateway_running; then
        log_info "Stopping stale fnOS gateway process before restarting DSH Web."
        stop_pid "${GATEWAY_PID_FILE}"
    fi
    cleanup_orphaned_runtime_processes
    rm -f "${SOCKET_PATH}"
    mkdir -p "${TRIM_PKGVAR}/gateway"
    log_info "Starting DeepSeek Harness on ${HOST}:${PORT}..."

    (
        cd "${TRIM_APPDEST}" || exit 1
        GATEWAY_SOCKET="${SOCKET_PATH}" \
            GATEWAY_PREFIX="${GATEWAY_PREFIX}" \
            GATEWAY_PATH_ALLOWLIST="${TRIM_PKGVAR}/gateway/path-allowlist.json" \
            DSH_UPSTREAM_HOST="127.0.0.1" \
            DSH_UPSTREAM_PORT="${PORT}" \
            DSH_BIN="${DSH_BIN}" \
            DSH_CWD="${TRIM_APPDEST}" \
            DSH_PID_FILE="${PID_FILE}" \
            DSH_START_LOCK_FILE="${TRIM_PKGVAR}/web-start.lock" \
            DSH_LAUNCH_TOKEN_FILE="${TRIM_PKGVAR}/gateway/web.token" \
            DSH_WEB_HOST="${HOST}" \
            DSH_TRUSTED_HOSTS="${TRUSTED_HOSTS}" \
            exec node "${PROXY_SCRIPT}"
    ) &
    printf "%s" "$!" >"${GATEWAY_PID_FILE}"
    return 0
}

stop_pid() {
    local pid_file="$1"
    if [ ! -r "${pid_file}" ]; then
        return 0
    fi

    local pid
    pid=$(pid_from_file "${pid_file}")
    if ! check_process "${pid}"; then
        rm -f "${pid_file}"
        return 0
    fi

    stop_runtime_pid "${pid}"
    rm -f "${pid_file}"
}

stop_process() {
    if [ "${FNOS_INTERNAL_RESTART:-0}" != "1" ]; then
        rm -f "${RESTART_MARKER}"
    fi
    stop_pid "${GATEWAY_PID_FILE}"
    # The gateway normally terminates its DSH child. Keep this fallback for a
    # gateway crash during uninstall or package shutdown.
    stop_pid "${PID_FILE}"
    cleanup_orphaned_runtime_processes
    rm -f "${SOCKET_PATH}"
    return 0
}

status() {
    if gateway_running || restart_in_progress; then
        return 0
    fi

    rm -f "${GATEWAY_PID_FILE}"
    return 1
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
