#!/bin/bash

NODE_BIN="/var/apps/nodejs_v24/target/bin"
DSH_HOME="${TRIM_PKGHOME}"
APP_HOME="${TRIM_APPDEST_VOL}/@appshare/fn-deepseek-harness"
APP_DEST="${TRIM_APPDEST}"
NPM_CONFIG_PREFIX="${DSH_HOME}/.npm-global"
NPM_BIN="${NODE_BIN}/npm"
DSH_BIN="${NPM_CONFIG_PREFIX}/bin/dsh"
DSH_PACKAGE="@deepseek-ai/dsh"
DSH_VERSION="0.1.2-alpha.4"
DSH_VERSION_FILE="${APP_DEST}/dsh-version"
DSH_NODE_PTY_SCRIPT="${APP_DEST}/scripts/install-node-pty.sh"
DSH_PLUGIN_SCRIPT="${APP_DEST}/scripts/install-dsh-plugins.mjs"
DSH_ATTACHMENT_PATCH_SCRIPT="${APP_DEST}/scripts/patch-dsh-attachment-local.mjs"
DSH_PUBLISHED_PLUGIN_MANIFEST="${APP_DEST}/published-dsh-plugins.json"
DSH_PROFILE_DIRECTORY="${DSH_HOME}/profiles/web"
PROXY_SCRIPT="${APP_DEST}/gateway-proxy.mjs"
NPM_REGISTRY_FILE="${APP_HOME}/.fn-deepseek-harness/npm-registry"

export DSH_HOME
export HOME="${APP_HOME}"
export NPM_CONFIG_CACHE="${DSH_HOME}/.npm-cache"
export NPM_CONFIG_PREFIX
export PATH="${NODE_BIN}:${NPM_CONFIG_PREFIX}/bin:${PATH}"

log_message() {
    local level="$1"
    shift
    printf '[%s] [install_callback] [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${level}" "$*"
}

log_info() {
    log_message INFO "$@"
}

log_error() {
    log_message ERROR "$@" >&2
}

select_npm() {
    [ -x "${NPM_BIN}" ] || fail_install "npm is not available in the nodejs_v24 runtime"
    NPM_VERSION="$(${NPM_BIN} --version 2>/dev/null || true)"
    log_info "Using npm ${NPM_VERSION:-unknown} for DSH and plugin installation."
}

global_package_root() {
    "${NPM_BIN}" root -g 2>/dev/null || true
}

resolve_dsh_package_dir() {
    DSH_PACKAGE_DIR="${NPM_GLOBAL_ROOT}/${DSH_PACKAGE}"
}

fail_install() {
    local message="$1"
    local formatted_message
    formatted_message="$(log_message ERROR "${message}")"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "${formatted_message}" >"${TRIM_TEMP_LOGFILE}"
    fi
    printf '%s\n' "${formatted_message}" >&2
    exit 1
}

install_published_dsh_plugins() {
    [ -f "${DSH_PLUGIN_SCRIPT}" ] || return 0

    if [ ! -f "${DSH_PROFILE_DIRECTORY}/package.json" ]; then
        "${DSH_BIN}" --profile web --dump-config >/dev/null 2>&1 ||
            fail_install "Unable to initialize the dsh web profile"
    fi

    DSH_PUBLISHED_PLUGIN_MANIFEST="${DSH_PUBLISHED_PLUGIN_MANIFEST}" \
        DSH_PROFILE_DIRECTORY="${DSH_PROFILE_DIRECTORY}" \
        DSH_INSTALL_PUBLISHED=1 \
        PACKAGE_MANAGER="npm" \
        PACKAGE_MANAGER_BIN="${NPM_BIN}" \
        NPM_BIN="${NPM_BIN}" \
        NPM_REGISTRY="${NPM_REGISTRY}" \
        "${NODE_BIN}/node" "${DSH_PLUGIN_SCRIPT}" ||
        fail_install "Unable to install the published DSH plugins"
}

patch_dsh_attachment_local() {
    local attachment_package_json attachment_local_version
    [ -f "${DSH_ATTACHMENT_PATCH_SCRIPT}" ] ||
        fail_install "The dsh attachment patch script is not available at ${DSH_ATTACHMENT_PATCH_SCRIPT}"
    [ -n "${TRIM_PKGVAR:-}" ] ||
        fail_install "TRIM_PKGVAR is not available; cannot patch dsh attachment persistence"

    attachment_package_json="${DSH_PACKAGE_DIR}/node_modules/@deepseek-ai/dsh-attachment-local/package.json"
    attachment_local_version="$(read_package_version "${attachment_package_json}")"
    [ -n "${attachment_local_version}" ] ||
        fail_install "The installed DSH dependency does not provide @deepseek-ai/dsh-attachment-local"

    log_info "Patching installed @deepseek-ai/dsh-attachment-local@${attachment_local_version} for DSH ${DSH_VERSION}."

    DSH_ATTACHMENT_LOCAL_DIR="${DSH_PACKAGE_DIR}/node_modules/@deepseek-ai/dsh-attachment-local" \
        DSH_ATTACHMENT_LOCAL_VERSION="${attachment_local_version}" \
        TRIM_PKGVAR="${TRIM_PKGVAR}" \
        "${NODE_BIN}/node" "${DSH_ATTACHMENT_PATCH_SCRIPT}" ||
        fail_install "Unable to patch dsh attachment persistence"
}

read_package_version() {
    local package_json="$1"
    [ -f "${package_json}" ] || return 0
    "${NODE_BIN}/node" -e '
const fs = require("node:fs")
try {
    const value = JSON.parse(fs.readFileSync(process.argv[1], "utf8")).version
    if (typeof value === "string") process.stdout.write(value)
} catch {}
' "${package_json}" 2>/dev/null || true
}

read_trimmed_file() {
    local file="$1"
    [ -f "${file}" ] || return 0
    tr -d '[:space:]' <"${file}"
}

validate_install_configuration() {
    [ -f "${PROXY_SCRIPT}" ] ||
        fail_install "DeepSeek Harness gateway proxy is not available at ${PROXY_SCRIPT}"

    if { [ "${wizard_host+x}" = "x" ] || [ "${wizard_trusted_hosts+x}" = "x" ]; } &&
        [ "${wizard_host:-127.0.0.1}" = "127.0.0.1" ] &&
        [ -z "${wizard_trusted_hosts:-}" ]; then
        fail_install "No trusted NAS Web host configured; set the trusted access address to the NAS host or host:port"
    fi
}

run_node_pty_script() {
    local run_dependency_scripts="$1"
    [ -f "${DSH_NODE_PTY_SCRIPT}" ] ||
        fail_install "The FPK node-pty installer is not available at ${DSH_NODE_PTY_SCRIPT}"

    DSH_HOME="${DSH_HOME}" \
        DSH_VERSION="${DSH_VERSION}" \
        DSH_VERSION_FILE="${DSH_VERSION_FILE}" \
        DSH_NATIVE_BUNDLE="${APP_DEST}/native/node-pty" \
        NODE_PTY_VERSIONS_FILE="${APP_DEST}/node-pty-versions" \
        DSH_PACKAGE_DIR="${DSH_PACKAGE_DIR}" \
        NPM_GLOBAL_ROOT="${NPM_GLOBAL_ROOT}" \
        NODE_BIN="${NODE_BIN}" \
        NPM_BIN="${NPM_BIN}" \
        PACKAGE_MANAGER="npm" \
        PACKAGE_MANAGER_BIN="${NPM_BIN}" \
        DSH_RUN_DEPENDENCY_SCRIPTS="${run_dependency_scripts}" \
        bash "${DSH_NODE_PTY_SCRIPT}" ||
        fail_install "Unable to prepare the bundled node-pty dependencies"
}

has_bundled_node_pty() {
    [ "$(read_trimmed_file "${DSH_VERSION_FILE}")" = "${DSH_VERSION}" ] &&
        [ -s "${APP_DEST}/node-pty-versions" ] &&
        [ -d "${APP_DEST}/native/node-pty" ]
}

main() {
    if [ ! -x "${NODE_BIN}/node" ]; then
        fail_install "nodejs_v24 runtime is not available at ${NODE_BIN}"
    fi

    select_npm

    mkdir -p "${DSH_HOME}/.npm-cache" "${NPM_CONFIG_PREFIX}" "${HOME}" ||
        fail_install "Unable to prepare the dsh package manager directories"

    NPM_REGISTRY="${wizard_npm_registry:-https://registry.npmjs.org/}"
    mkdir -p "$(dirname -- "${NPM_REGISTRY_FILE}")" ||
        fail_install "Unable to prepare the npm registry configuration directory"
    printf '%s\n' "${NPM_REGISTRY}" >"${NPM_REGISTRY_FILE}" ||
        fail_install "Unable to save the npm registry configuration"

    validate_install_configuration

    NPM_GLOBAL_ROOT="$(global_package_root)"
    if [ -z "${NPM_GLOBAL_ROOT}" ]; then
        NPM_GLOBAL_ROOT="${NPM_CONFIG_PREFIX}/lib/node_modules"
    fi
    resolve_dsh_package_dir

    LOCAL_VERSION="$(read_package_version "${DSH_PACKAGE_DIR}/package.json")"
    RUN_NODE_PTY_DEPENDENCY_SCRIPTS=0
    if [ -x "${DSH_BIN}" ] && [ "${LOCAL_VERSION}" = "${DSH_VERSION}" ]; then
        log_info "Using locally installed ${DSH_PACKAGE}@${DSH_VERSION}."
    else
        if [ -n "${LOCAL_VERSION}" ]; then
            log_info "Local ${DSH_PACKAGE}@${LOCAL_VERSION} does not match required ${DSH_VERSION}; reinstalling the required version."
        else
            log_info "No usable local ${DSH_PACKAGE}@${DSH_VERSION}; installing the required version."
        fi
        log_info "Installing ${DSH_PACKAGE}@${DSH_VERSION} globally from ${NPM_REGISTRY}..."
        if ! "${NPM_BIN}" install "${DSH_PACKAGE}@${DSH_VERSION}" -g \
            --registry="${NPM_REGISTRY}" --ignore-scripts; then
            fail_install "Failed to install ${DSH_PACKAGE}@${DSH_VERSION} from ${NPM_REGISTRY}"
        fi
        NPM_GLOBAL_ROOT="$(global_package_root)"
        if [ -z "${NPM_GLOBAL_ROOT}" ]; then
            NPM_GLOBAL_ROOT="${NPM_CONFIG_PREFIX}/lib/node_modules"
        fi
        resolve_dsh_package_dir
        RUN_NODE_PTY_DEPENDENCY_SCRIPTS=1
    fi

    if has_bundled_node_pty; then
        log_info "Using FPK bundled node-pty native files when the NAS compiler is unavailable."
    else
        log_info "FPK has no bundled node-pty native files; the NAS must provide g++ for native compilation."
        RUN_NODE_PTY_DEPENDENCY_SCRIPTS=1
    fi

    LOCAL_VERSION="$(read_package_version "${DSH_PACKAGE_DIR}/package.json")"
    [ "${LOCAL_VERSION}" = "${DSH_VERSION}" ] ||
        fail_install "Installed ${DSH_PACKAGE} version ${LOCAL_VERSION:-unknown} does not match required ${DSH_VERSION}"

    run_node_pty_script "${RUN_NODE_PTY_DEPENDENCY_SCRIPTS}"
    patch_dsh_attachment_local
    if [ ! -x "${DSH_BIN}" ] || ! "${DSH_BIN}" --help >/dev/null 2>&1; then
        fail_install "dsh installation verification failed: dsh --help"
    fi

    log_info "dsh ${DSH_PACKAGE}@${DSH_VERSION} installation verified at ${DSH_BIN}."
    install_published_dsh_plugins
}

main "$@"
