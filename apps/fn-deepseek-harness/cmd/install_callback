#!/bin/bash

NODE_BIN="/var/apps/nodejs_v24/target/bin"
DSH_HOME="${TRIM_PKGHOME}"
APP_HOME="${TRIM_APPDEST_VOL}/@appshare/fn-deepseek-harness"
APP_DEST="${TRIM_APPDEST}"
NPM_CONFIG_PREFIX="${DSH_HOME}/.npm-global"
PNPM_STORE_DIR="${APP_HOME}/.local/share/pnpm/store"
PNPM_STORE_FILE="${DSH_HOME}/.pnpm-store-dir"
NPM_BIN="${NODE_BIN}/npm"
DSH_BIN="${NPM_CONFIG_PREFIX}/bin/dsh"
DSH_PACKAGE="@deepseek-ai/dsh"
DSH_VERSION="0.1.5-rc.2"
PNPM_VERSION="11.7.0"
PNPM_BIN="${NPM_CONFIG_PREFIX}/bin/pnpm"
DSH_VERSION_FILE="${APP_DEST}/dsh-version"
DSH_NODE_PTY_SCRIPT="${APP_DEST}/scripts/install-node-pty.sh"
DSH_ATTACHMENT_PATCH_SCRIPT="${APP_DEST}/scripts/patch-dsh-attachment-local.mjs"
DSH_PUBLISHED_PLUGIN_MANIFEST="${APP_DEST}/published-dsh-plugins.json"
DSH_BUNDLED_PLUGIN_DIRECTORY="${APP_DEST}/bundled-dsh-plugins"
DSH_PROFILE_DIRECTORY="${DSH_HOME}/profiles/web"
PROXY_SCRIPT="${APP_DEST}/gateway-proxy.mjs"
NPM_USER_CONFIG_FILE="${DSH_HOME}/.npmrc"
LEGACY_NPM_REGISTRY_FILE="${APP_HOME}/.fn-deepseek-harness/npm-registry"
APP_UID="${TRIM_UID:-}"
APP_GROUP="${TRIM_GROUPNAME:-}"
ID_BIN="/usr/bin/id"
ENV_BIN="/usr/bin/env"
STAT_BIN="/usr/bin/stat"
CHOWN_BIN="/usr/bin/chown"
RUNUSER_BIN=""

export DSH_HOME
export HOME="${APP_HOME}"
export NPM_CONFIG_CACHE="${DSH_HOME}/.npm-cache"
export NPM_CONFIG_PREFIX
export NPM_CONFIG_USERCONFIG="${NPM_USER_CONFIG_FILE}"
export PATH="${NODE_BIN}:${NPM_CONFIG_PREFIX}/bin:${PATH}"

log_message() {
    local level="$1"
    shift
    printf '[%s] [install_callback] [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${level}" "$*"
}

log_info() {
    log_message INFO "$@"
}

log_error() {
    log_message ERROR "$@" >&2
}

select_npm() {
    [ -x "${NPM_BIN}" ] || fail_install "npm is not available in the nodejs_v24 runtime"
    NPM_VERSION="$(run_as_app_user "${NPM_BIN}" --version 2>/dev/null || true)"
    log_info "Using npm ${NPM_VERSION:-unknown} for DSH and plugin installation."
}

installed_pnpm_version() {
    [ -x "${PNPM_BIN}" ] || return 0
    run_as_app_user "${PNPM_BIN}" --version 2>/dev/null || true
}

has_required_pnpm() {
    [ "$(installed_pnpm_version)" = "${PNPM_VERSION}" ]
}

global_package_root() {
    run_as_app_user "${NPM_BIN}" root -g 2>/dev/null || true
}

resolve_dsh_package_dir() {
    DSH_PACKAGE_DIR="${NPM_GLOBAL_ROOT}/${DSH_PACKAGE}"
}

fail_install() {
    local message="$1"
    local formatted_message
    formatted_message="$(log_message ERROR "${message}")"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "${formatted_message}" >"${TRIM_TEMP_LOGFILE}"
    fi
    printf '%s\n' "${formatted_message}" >&2
    exit 1
}

prepare_app_user() {
    [ -x "${ID_BIN}" ] && [ -x "${ENV_BIN}" ] && [ -x "${STAT_BIN}" ] && [ -x "${CHOWN_BIN}" ] ||
        fail_install "Required user and ownership utilities are unavailable"
    if [ -n "${APP_UID}" ]; then
        case "${APP_UID}" in
        *[!0-9]* | 0) fail_install "TRIM_UID is invalid; cannot select the DSH application user" ;;
        esac
    fi
    [ -n "${APP_UID}" ] || fail_install "TRIM_UID is not available; cannot select the DSH application user"
    if [ -z "${APP_GROUP}" ]; then
        APP_GROUP="$(${ID_BIN} -gn "${APP_UID}" 2>/dev/null || true)"
    fi
    [ -n "${APP_GROUP}" ] || fail_install "TRIM_GROUPNAME is not available; cannot protect DSH profile ownership"
    for candidate in /usr/sbin/runuser /usr/bin/runuser; do
        if [ -x "${candidate}" ]; then
            RUNUSER_BIN="${candidate}"
            break
        fi
    done
    [ -n "${RUNUSER_BIN}" ] || fail_install "runuser is required to manage DSH as the application user"

    if [ "$(${ID_BIN} -u)" = "0" ]; then
        mkdir -p "${DSH_HOME}" || fail_install "Unable to create the DSH application home"
        "${CHOWN_BIN}" -R "${APP_UID}:${APP_GROUP}" "${DSH_HOME}" ||
            fail_install "Unable to assign DSH application home to ${APP_UID}:${APP_GROUP}"
    else
        [ "$(${ID_BIN} -u)" = "${APP_UID}" ] ||
            fail_install "Install callback must run as UID ${APP_UID} or root"
    fi
}

run_as_app_user() {
    if [ "$(${ID_BIN} -u)" = "${APP_UID}" ]; then
        HOME="${DSH_HOME}" DSH_HOME="${DSH_HOME}" \
            NPM_CONFIG_CACHE="${DSH_HOME}/.npm-cache" \
            NPM_CONFIG_PREFIX="${NPM_CONFIG_PREFIX}" \
            NPM_CONFIG_USERCONFIG="${NPM_USER_CONFIG_FILE}" \
            PNPM_CONFIG_STORE_DIR="${PNPM_STORE_DIR}" \
            PATH="${NODE_BIN}:${NPM_CONFIG_PREFIX}/bin:/usr/bin:/bin" "$@"
        return
    fi
    "${RUNUSER_BIN}" --user "${APP_UID}" --group "${APP_GROUP}" -- \
        "${ENV_BIN}" HOME="${DSH_HOME}" DSH_HOME="${DSH_HOME}" \
        NPM_CONFIG_CACHE="${DSH_HOME}/.npm-cache" \
        NPM_CONFIG_PREFIX="${NPM_CONFIG_PREFIX}" \
        NPM_CONFIG_USERCONFIG="${NPM_USER_CONFIG_FILE}" \
        PNPM_CONFIG_STORE_DIR="${PNPM_STORE_DIR}" \
        PATH="${NODE_BIN}:${NPM_CONFIG_PREFIX}/bin:/usr/bin:/bin" "$@"
}

remove_legacy_pnpm_store_config() {
    [ -f "${NPM_USER_CONFIG_FILE}" ] || return 0
    run_as_app_user "${ENV_BIN}" \
        PNPM_USER_CONFIG_FILE="${NPM_USER_CONFIG_FILE}" \
        "${NODE_BIN}/node" -e '
const fs = require("node:fs")
const path = require("node:path")
const configPath = process.env.PNPM_USER_CONFIG_FILE
if (!configPath) process.exit(2)
const source = fs.readFileSync(configPath, "utf8")
const lines = source.split(/\r?\n/)
const filtered = lines.filter(line => !/^\s*store-dir\s*=/.test(line))
if (filtered.length === lines.length) process.exit(0)
while (filtered.at(-1) === "") filtered.pop()
const mode = fs.statSync(configPath).mode & 0o777
const temporaryPath = `${configPath}.tmp-${process.pid}`
fs.writeFileSync(temporaryPath, `${filtered.join("\n")}\n`, { mode })
fs.chmodSync(temporaryPath, mode)
fs.renameSync(temporaryPath, configPath)
' || fail_install "Unable to remove legacy pnpm store-dir from ${NPM_USER_CONFIG_FILE}"
}

read_persisted_npm_registry() {
    local registry
    if [ -f "${NPM_USER_CONFIG_FILE}" ]; then
        registry="$(run_as_app_user "${NPM_BIN}" config get registry --location=user 2>/dev/null || true)"
    elif [ -f "${LEGACY_NPM_REGISTRY_FILE}" ]; then
        registry="$(tr -d '[:space:]' <"${LEGACY_NPM_REGISTRY_FILE}" 2>/dev/null || true)"
    fi
    printf '%s' "${registry:-https://registry.npmjs.org/}"
}

persist_npm_registry() {
    run_as_app_user "${NPM_BIN}" config set registry "${NPM_REGISTRY}" --location=user ||
        fail_install "Unable to persist npm registry in ${NPM_USER_CONFIG_FILE}"
}

profile_dependency_version() {
    local package_name="$1"
    [ -f "${DSH_PROFILE_DIRECTORY}/package.json" ] || return 0
    PACKAGE_NAME="${package_name}" "${NODE_BIN}/node" -e '
const fs = require("node:fs")
const name = process.env.PACKAGE_NAME
try {
    const manifest = JSON.parse(fs.readFileSync(process.argv[1], "utf8"))
    const dependencies = { ...(manifest.dependencies || {}), ...(manifest.devDependencies || {}) }
    const value = dependencies[name]
    if (typeof value === "string") process.stdout.write(value)
} catch {}
' "${DSH_PROFILE_DIRECTORY}/package.json" 2>/dev/null || true
}

profile_store_dir() {
    local modules_file="${DSH_PROFILE_DIRECTORY}/node_modules/.modules.yaml"
    [ -f "${modules_file}" ] || return 0
    "${NODE_BIN}/node" -e '
const fs = require("node:fs")
try {
    const text = fs.readFileSync(process.argv[1], "utf8")
    const value = text.match(/^storeDir:\s*(.+?)\s*$/m)?.[1]
    if (value) process.stdout.write(value.replace(/\/v\d+\/?$/, ""))
} catch {}
' "${modules_file}" 2>/dev/null || true
}

persist_pnpm_store_dir() {
    run_as_app_user "${ENV_BIN}" \
        PNPM_STORE_DIR="${PNPM_STORE_DIR}" \
        PNPM_USER_CONFIG_FILE="${NPM_USER_CONFIG_FILE}" \
        PNPM_STORE_FILE="${PNPM_STORE_FILE}" \
        "${NODE_BIN}/node" -e '
const fs = require("node:fs")
const path = require("node:path")
const configPath = process.env.PNPM_USER_CONFIG_FILE
const storeDir = process.env.PNPM_STORE_DIR
const storeFile = process.env.PNPM_STORE_FILE
if (!configPath || !storeDir || !storeFile) process.exit(2)
fs.mkdirSync(path.dirname(storeFile), { recursive: true })
let storeMode = 0o600
try { storeMode = fs.statSync(storeFile).mode & 0o777 } catch {}
const storeTemporaryPath = `${storeFile}.tmp-${process.pid}`
fs.writeFileSync(storeTemporaryPath, `${storeDir}\n`, { mode: storeMode })
fs.chmodSync(storeTemporaryPath, storeMode)
fs.renameSync(storeTemporaryPath, storeFile)

let source = ""
try { source = fs.readFileSync(configPath, "utf8") } catch (error) { if (error?.code !== "ENOENT") throw error }
const lines = source.split(/\r?\n/).filter(line => !/^\s*store-dir\s*=/.test(line))
if (lines.length !== source.split(/\r?\n/).length) {
    while (lines.at(-1) === "") lines.pop()
    let configMode = 0o600
    try { configMode = fs.statSync(configPath).mode & 0o777 } catch {}
    fs.mkdirSync(path.dirname(configPath), { recursive: true })
    const configTemporaryPath = `${configPath}.tmp-${process.pid}`
    fs.writeFileSync(configTemporaryPath, `${lines.join("\n")}\n`, { mode: configMode })
    fs.chmodSync(configTemporaryPath, configMode)
    fs.renameSync(configTemporaryPath, configPath)
}
' || fail_install "Unable to persist pnpm store directory outside npm config"
}

configure_pnpm_store() {
    local profile_store
    profile_store="$(profile_store_dir)"
    if [ -n "${profile_store}" ]; then
        PNPM_STORE_DIR="${profile_store}"
        log_info "Reusing the existing pnpm store ${PNPM_STORE_DIR} referenced by the Web profile."
    else
        log_info "Using the persistent pnpm store ${PNPM_STORE_DIR}."
    fi
    persist_pnpm_store_dir
}

installed_plugin_version() {
    local package_name="$1"
    local package_json="${DSH_PROFILE_DIRECTORY}/node_modules/${package_name}/package.json"
    local version
    version="$(read_package_version "${package_json}")"
    [ -n "${version}" ] && printf '%s' "${version}" && return 0
    profile_dependency_version "${package_name}"
}

validate_plugin_spec() {
    case "$1" in
    '' | *[!0-9A-Za-z@/:_.+-]*) fail_install "Invalid DSH plugin package spec: $1" ;;
    esac
}

# Force one bundled plugin to take the FPK's copy, regardless of version.
#
# pnpm keys an install off the dependency *spec*: for `file:<bundled>.tgz` the
# spec never changes between FPK builds, and pnpm compares it against
# `node_modules/.modules.yaml` plus the integrity recorded in the lockfile. When
# the archive's contents changed but its path did not, `pnpm add` answers
# "Already up to date" and keeps the stale copy. `install --force`,
# `--fix-lockfile`, `update`, `rebuild` and `store prune` were all measured to
# behave the same way.
#
# The supported way to invalidate that state is to remove the package through
# the DSH CLI first, then add the FPK archive again. Using the CLI (rather than
# constructing an `rm -rf` path from manifest text) keeps removal safe across
# pnpm linkers and package layouts. The profile's dependency/bundle record is
# restored by the second command.
force_install_bundled_plugin() {
    local plugin_name="$1"
    local plugin_version="$2"
    local bundled_plugin="$3"
    local current_version="$4"

    if [ -n "${current_version}" ]; then
        log_info "Removing installed ${plugin_name} before replacing it with the FPK archive copy."
        run_dsh_plugin remove "${plugin_name}" ||
            fail_install "Unable to remove bundled ${plugin_name} before reinstalling it"
    fi
    run_dsh_plugin add "file:${bundled_plugin}" ||
        fail_install "Unable to install bundled ${plugin_name}@${plugin_version} with the dsh CLI"
}

run_dsh_plugin() {
    local action="$1"
    local package_spec="$2"
    validate_plugin_spec "${package_spec}"
    log_info "Running dsh plugin --profile web ${action} ${package_spec}."
    run_as_app_user "${DSH_BIN}" plugin --profile web "${action}" "${package_spec}"
}

install_published_dsh_plugins() {
    local plugin_name plugin_version current_version current_spec bundled_plugin
    while IFS=$'\t' read -r plugin_name plugin_version; do
        [ -n "${plugin_name}" ] || continue
        validate_plugin_spec "${plugin_name}"
        validate_plugin_spec "${plugin_version}"
        current_version="$(installed_plugin_version "${plugin_name}")"
        current_spec="$(profile_dependency_version "${plugin_name}")"

        # pnpm must install from a package archive, not link the FPK directory:
        # linked packages cannot resolve their own runtime dependencies here.
        #
        # A bundled plugin is always taken from the FPK archive, even when the
        # installed version matches: the spec path is identical across FPK
        # builds, so pnpm would otherwise treat a rebuilt archive as "already up
        # to date" and keep stale code. See `force_install_bundled_plugin`.
        bundled_plugin="${DSH_BUNDLED_PLUGIN_DIRECTORY}/${plugin_name}.tgz"
        if [ -f "${bundled_plugin}" ]; then
            force_install_bundled_plugin "${plugin_name}" "${plugin_version}" "${bundled_plugin}" "${current_version}"
            continue
        fi

        if [ -z "${current_version}" ]; then
            run_dsh_plugin add "${plugin_name}@${plugin_version}" ||
                fail_install "Unable to install ${plugin_name}@${plugin_version} with the dsh CLI"
        elif [ "${current_version}" != "${plugin_version}" ] || [[ "${current_spec}" == link:* ]]; then
            log_info "Updating ${plugin_name} from ${current_version} to ${plugin_version} with the dsh CLI."
            run_dsh_plugin add "${plugin_name}@${plugin_version}" ||
                fail_install "Unable to update ${plugin_name} to ${plugin_version} with the dsh CLI"
        else
            log_info "Keeping installed ${plugin_name}@${current_version}; exact version already matches."
        fi
    done < <("${NODE_BIN}/node" -e '
const fs = require("node:fs")
const manifest = JSON.parse(fs.readFileSync(process.argv[1], "utf8"))
for (const plugin of manifest.plugins || []) {
  if (typeof plugin.name === "string" && typeof plugin.version === "string") console.log(`${plugin.name}\t${plugin.version}`)
}
' "${DSH_PUBLISHED_PLUGIN_MANIFEST}")

    local dshmarket_version
    dshmarket_version="$(installed_plugin_version dshmarket)"
    if [ -n "${dshmarket_version}" ]; then
        log_info "Keeping installed dshmarket@${dshmarket_version}; the third-party plugin is install-once and non-destructive."
    else
        dshmarket_version="$("${NODE_BIN}/node" -e '
const fs = require("node:fs")
const manifest = JSON.parse(fs.readFileSync(process.argv[1], "utf8"))
const plugin = (manifest.bundled || []).find(value => value?.name === "dshmarket")
if (typeof plugin?.version === "string") process.stdout.write(plugin.version)
' "${DSH_PUBLISHED_PLUGIN_MANIFEST}")"
        [ -n "${dshmarket_version}" ] || fail_install "dshmarket is missing from the plugin manifest"
        run_dsh_plugin add "dshmarket@${dshmarket_version}" ||
            fail_install "Unable to install dshmarket@${dshmarket_version} with the dsh CLI"
    fi
}

patch_dsh_attachment_local() {
    local attachment_package_json attachment_local_version
    [ -f "${DSH_ATTACHMENT_PATCH_SCRIPT}" ] ||
        fail_install "The dsh attachment patch script is not available at ${DSH_ATTACHMENT_PATCH_SCRIPT}"
    [ -n "${TRIM_PKGVAR:-}" ] ||
        fail_install "TRIM_PKGVAR is not available; cannot patch dsh attachment persistence"

    attachment_package_json="${DSH_PACKAGE_DIR}/node_modules/@deepseek-ai/dsh-attachment-local/package.json"
    attachment_local_version="$(read_package_version "${attachment_package_json}")"
    [ -n "${attachment_local_version}" ] ||
        fail_install "The installed DSH dependency does not provide @deepseek-ai/dsh-attachment-local"

    log_info "Patching installed @deepseek-ai/dsh-attachment-local@${attachment_local_version} for DSH ${DSH_VERSION}."

    run_as_app_user "${ENV_BIN}" \
        DSH_ATTACHMENT_LOCAL_DIR="${DSH_PACKAGE_DIR}/node_modules/@deepseek-ai/dsh-attachment-local" \
        DSH_ATTACHMENT_LOCAL_VERSION="${attachment_local_version}" \
        TRIM_PKGVAR="${TRIM_PKGVAR}" \
        "${NODE_BIN}/node" "${DSH_ATTACHMENT_PATCH_SCRIPT}" ||
        fail_install "Unable to patch dsh attachment persistence"
}

read_package_version() {
    local package_json="$1"
    [ -f "${package_json}" ] || return 0
    "${NODE_BIN}/node" -e '
const fs = require("node:fs")
try {
    const value = JSON.parse(fs.readFileSync(process.argv[1], "utf8")).version
    if (typeof value === "string") process.stdout.write(value)
} catch {}
' "${package_json}" 2>/dev/null || true
}

read_package_name() {
    local package_json="$1"
    [ -f "${package_json}" ] || return 0
    "${NODE_BIN}/node" -e '
const fs = require("node:fs")
try {
    const value = JSON.parse(fs.readFileSync(process.argv[1], "utf8")).name
    if (typeof value === "string") process.stdout.write(value)
} catch {}
' "${package_json}" 2>/dev/null || true
}

read_trimmed_file() {
    local file="$1"
    [ -f "${file}" ] || return 0
    tr -d '[:space:]' <"${file}"
}

validate_install_configuration() {
    [ -f "${PROXY_SCRIPT}" ] ||
        fail_install "DeepSeek Harness gateway proxy is not available at ${PROXY_SCRIPT}"

    if { [ "${wizard_host+x}" = "x" ] || [ "${wizard_trusted_hosts+x}" = "x" ]; } &&
        [ "${wizard_host:-127.0.0.1}" = "127.0.0.1" ] &&
        [ -z "${wizard_trusted_hosts:-}" ]; then
        fail_install "No trusted NAS Web host configured; set the trusted access address to the NAS host or host:port"
    fi
}

run_node_pty_script() {
    local run_dependency_scripts="$1"
    [ -f "${DSH_NODE_PTY_SCRIPT}" ] ||
        fail_install "The FPK node-pty installer is not available at ${DSH_NODE_PTY_SCRIPT}"

    run_as_app_user "${ENV_BIN}" \
        DSH_HOME="${DSH_HOME}" \
        DSH_VERSION="${DSH_VERSION}" \
        DSH_VERSION_FILE="${DSH_VERSION_FILE}" \
        DSH_NATIVE_BUNDLE="${APP_DEST}/native/node-pty" \
        NODE_PTY_VERSIONS_FILE="${APP_DEST}/node-pty-versions" \
        DSH_PACKAGE_DIR="${DSH_PACKAGE_DIR}" \
        NPM_GLOBAL_ROOT="${NPM_GLOBAL_ROOT}" \
        NODE_BIN="${NODE_BIN}" \
        NPM_BIN="${NPM_BIN}" \
        PACKAGE_MANAGER="npm" \
        PACKAGE_MANAGER_BIN="${NPM_BIN}" \
        DSH_RUN_DEPENDENCY_SCRIPTS="${run_dependency_scripts}" \
        /bin/bash "${DSH_NODE_PTY_SCRIPT}" ||
        fail_install "Unable to prepare the bundled node-pty dependencies"
}

has_required_dsh() {
    [ -x "${DSH_BIN}" ] || return 1
    [ "$(read_package_version "${DSH_PACKAGE_DIR}/package.json")" = "${DSH_VERSION}" ] || return 1
    [ "$(run_as_app_user "${DSH_BIN}" --version 2>/dev/null || true)" = "${DSH_VERSION}" ]
}

has_bundled_node_pty() {
    [ "$(read_trimmed_file "${DSH_VERSION_FILE}")" = "${DSH_VERSION}" ] &&
        [ -s "${APP_DEST}/node-pty-versions" ] &&
        [ -d "${APP_DEST}/native/node-pty" ]
}

main() {
    if [ ! -x "${NODE_BIN}/node" ]; then
        fail_install "nodejs_v24 runtime is not available at ${NODE_BIN}"
    fi

    prepare_app_user
    remove_legacy_pnpm_store_config
    select_npm

    run_as_app_user /bin/mkdir -p "${DSH_HOME}/.npm-cache" "${NPM_CONFIG_PREFIX}" "${HOME}" ||
        fail_install "Unable to prepare the dsh package manager directories"

    NPM_REGISTRY="${wizard_npm_registry:-$(read_persisted_npm_registry)}"
    NPM_REGISTRY="${NPM_REGISTRY:-https://registry.npmjs.org/}"
    persist_npm_registry

    if has_required_pnpm; then
        log_info "Using locally installed pnpm@${PNPM_VERSION}; installation skipped."
    else
        log_info "Installing pnpm@${PNPM_VERSION} globally for DSH plugin management."
        run_as_app_user "${NPM_BIN}" install "pnpm@${PNPM_VERSION}" -g --ignore-scripts ||
            fail_install "Unable to install pnpm@${PNPM_VERSION}"
    fi
    [ "$(installed_pnpm_version)" = "${PNPM_VERSION}" ] ||
        fail_install "Installed pnpm version does not match ${PNPM_VERSION}"

    validate_install_configuration

    NPM_GLOBAL_ROOT="$(global_package_root)"
    if [ -z "${NPM_GLOBAL_ROOT}" ]; then
        NPM_GLOBAL_ROOT="${NPM_CONFIG_PREFIX}/lib/node_modules"
    fi
    resolve_dsh_package_dir

    LOCAL_VERSION="$(read_package_version "${DSH_PACKAGE_DIR}/package.json")"
    RUN_NODE_PTY_DEPENDENCY_SCRIPTS=0
    if has_required_dsh; then
        log_info "Using locally installed ${DSH_PACKAGE}@${DSH_VERSION}; installation skipped."
    else
        if [ -n "${LOCAL_VERSION}" ]; then
            log_info "Local ${DSH_PACKAGE}@${LOCAL_VERSION} does not match required ${DSH_VERSION}; reinstalling the required version."
        else
            log_info "No usable local ${DSH_PACKAGE}@${DSH_VERSION}; installing the required version."
        fi
        log_info "Installing ${DSH_PACKAGE}@${DSH_VERSION} globally from ${NPM_REGISTRY}..."
        if ! run_as_app_user "${NPM_BIN}" install "${DSH_PACKAGE}@${DSH_VERSION}" -g --ignore-scripts; then
            fail_install "Failed to install ${DSH_PACKAGE}@${DSH_VERSION} from ${NPM_REGISTRY}"
        fi
        NPM_GLOBAL_ROOT="$(global_package_root)"
        if [ -z "${NPM_GLOBAL_ROOT}" ]; then
            NPM_GLOBAL_ROOT="${NPM_CONFIG_PREFIX}/lib/node_modules"
        fi
        resolve_dsh_package_dir
        RUN_NODE_PTY_DEPENDENCY_SCRIPTS=1
    fi

    if has_bundled_node_pty; then
        log_info "Using FPK bundled node-pty native files when the NAS compiler is unavailable."
    else
        log_info "FPK has no bundled node-pty native files; the NAS must provide g++ for native compilation."
        RUN_NODE_PTY_DEPENDENCY_SCRIPTS=1
    fi

    LOCAL_VERSION="$(read_package_version "${DSH_PACKAGE_DIR}/package.json")"
    [ "${LOCAL_VERSION}" = "${DSH_VERSION}" ] ||
        fail_install "Installed ${DSH_PACKAGE} version ${LOCAL_VERSION:-unknown} does not match required ${DSH_VERSION}"

    run_node_pty_script "${RUN_NODE_PTY_DEPENDENCY_SCRIPTS}"
    patch_dsh_attachment_local
    configure_pnpm_store
    if [ ! -x "${DSH_BIN}" ] || ! run_as_app_user "${DSH_BIN}" --help >/dev/null 2>&1; then
        fail_install "dsh installation verification failed: dsh --help"
    fi
    DSH_REPORTED_VERSION="$(run_as_app_user "${DSH_BIN}" --version 2>/dev/null || true)"
    [ "${DSH_REPORTED_VERSION}" = "${DSH_VERSION}" ] ||
        fail_install "dsh --version reported ${DSH_REPORTED_VERSION:-unknown}; expected ${DSH_VERSION}"

    log_info "dsh ${DSH_PACKAGE}@${DSH_VERSION} installation verified at ${DSH_BIN}."
    install_published_dsh_plugins
}

main "$@"
