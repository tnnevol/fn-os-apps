#!/usr/bin/env bash

set -euo pipefail

APP_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST="${APP_DIR}/manifest"
BUMP_PART="${VERSION_BUMP:-patch}"

fail() {
    echo "build: $*" >&2
    exit 1
}

command -v fnpack >/dev/null 2>&1 || fail "fnpack is not installed or not in PATH"
[ -f "${MANIFEST}" ] || fail "manifest not found: ${MANIFEST}"

VERSION_LINE_COUNT="$(grep -Ec '^[[:space:]]*version[[:space:]]*=' "${MANIFEST}" || true)"
[ "${VERSION_LINE_COUNT}" -eq 1 ] || fail "manifest must contain exactly one version field"

CURRENT_VERSION="$(awk '
    /^[[:space:]]*version[[:space:]]*=/ {
        sub(/^[^=]*=/, "")
        gsub(/[[:space:]]/, "")
        print
        exit
    }
' "${MANIFEST}")"

if [[ ! "${CURRENT_VERSION}" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    fail "unsupported version '${CURRENT_VERSION}'; expected X.Y.Z"
fi

MAJOR="${BASH_REMATCH[1]}"
MINOR="${BASH_REMATCH[2]}"
PATCH="${BASH_REMATCH[3]}"
case "${BUMP_PART}" in
major)
    NEXT_VERSION="$((MAJOR + 1)).0.0"
    ;;
minor)
    NEXT_VERSION="${MAJOR}.$((MINOR + 1)).0"
    ;;
patch)
    NEXT_VERSION="${MAJOR}.${MINOR}.$((PATCH + 1))"
    ;;
*)
    fail "VERSION_BUMP must be major, minor, or patch"
    ;;
esac

MANIFEST_BACKUP="$(mktemp "${TMPDIR:-/tmp}/fn-deepseek-harness-manifest.XXXXXX")"
cp "${MANIFEST}" "${MANIFEST_BACKUP}"

restore_manifest() {
    cp "${MANIFEST_BACKUP}" "${MANIFEST}"
}

cleanup() {
    rm -f "${MANIFEST_BACKUP}" "${MANIFEST}.bak"
}
trap cleanup EXIT

sed -E -i.bak "s/^[[:space:]]*version[[:space:]]*=.*/version               = ${NEXT_VERSION}/" "${MANIFEST}"
rm -f "${MANIFEST}.bak"

echo "Version: ${CURRENT_VERSION} -> ${NEXT_VERSION}"
build_package() {
    rm -rf "${APP_DIR}/app/plugins"
    (cd "${APP_DIR}" && fnpack build) || return 1
}

if ! build_package; then
    restore_manifest
    echo "Build failed; restored version ${CURRENT_VERSION}." >&2
    exit 1
fi

echo "Built ${APP_DIR}/fn-deepseek-harness.fpk (version ${NEXT_VERSION})"
