[
    {
        "stepTitle": "服务配置",
        "items": [
            {
                "type": "tips",
                "helpText": "应用通过 fnOS 统一网关在 NAS Web 中打开，不需要对外开放端口。升级后应用会按这里的配置启动。"
            },
            {
                "type": "select",
                "field": "wizard_host",
                "label": "监听地址",
                "initValue": "127.0.0.1",
                "helpText": "DSH 暂不支持 0.0.0.0，保持 127.0.0.1 即可。",
                "options": [
                    {
                        "label": "127.0.0.1（仅本机）",
                        "value": "127.0.0.1"
                    },
                    {
                        "label": "0.0.0.0（暂不支持）",
                        "value": "0.0.0.0",
                        "disabled": true
                    }
                ]
            },
            {
                "type": "text",
                "field": "wizard_port",
                "label": "监听端口",
                "initValue": "3080",
                "helpText": "DSH Web 的监听端口。iframe 入口需要固定端口，不能填 0。",
                "rules": [
                    {
                        "required": true,
                        "message": "请输入监听端口"
                    },
                    {
                        "pattern": "^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                        "message": "请输入 1-65535 之间的端口号"
                    }
                ]
            },
            {
                "type": "text",
                "field": "wizard_trusted_hosts",
                "label": "可信访问地址",
                "initValue": "",
                "helpText": "填浏览器打开 NAS Web 时地址栏里的 host 或 host:port，例如 192.168.119.6:5666。不确定端口就只填 host；多个地址用英文逗号分隔。不要填 3080，那是 DSH 自己的端口。",
                "rules": [
                    {
                        "required": true,
                        "message": "请输入 NAS Web 的 host 或 host:port"
                    },
                    {
                        "pattern": "^(?:[^,\\s]+(?:,[^,\\s]+)*)?$",
                        "message": "请输入 host 或 host:port，多个地址用英文逗号分隔"
                    }
                ]
            }
        ]
    }
]
