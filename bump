#!/usr/bin/env bash
#
# 升级项目版本和 apps/ 目录下应用的 manifest version 字段。
# plugins/ 下的插件版本独立维护，禁止由本脚本更新。
#
# Usage:
#   ./bump major          # 大版本 +1（如 4.4.1 → 5.0.0）
#   ./bump minor          # 中版本 +1（如 4.4.1 → 4.5.0）
#   ./bump patch          # 小版本 +1（如 4.4.1 → 4.4.2）
#   ./bump -t 4.5.0       # 指定版本号（无前缀）
#   ./bump -t v4.5.0      # 指定版本号（带 v 前缀）
#   ./bump --tag v4.5.0   # 指定版本号（带 v 前缀）
#
# 选项:
#   --no-commit    仅修改文件，不自动 commit 和打 tag
#   --no-tag       自动 commit 但不打 tag

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PACKAGE_JSON="$SCRIPT_DIR/package.json"
APPS_DIR="$SCRIPT_DIR/apps"

# ── 参数解析 ──────────────────────────────────────────────
MODE=""
TARGET_VERSION=""
DO_COMMIT=true
DO_TAG=true

usage() {
  echo "Usage:"
  echo "  $0 <command> [options]"
  echo ""
  echo "Commands:"
  echo "  major          大版本 +1（如 4.4.1 → 5.0.0）"
  echo "  minor          中版本 +1（如 4.4.1 → 4.5.0）"
  echo "  patch          小版本 +1（如 4.4.1 → 4.4.2）"
  echo ""
  echo "Options:"
  echo "  -t, --tag <version>  指定目标版本号（如 4.5.0 或 v4.5.0）"
  echo "  --no-commit          仅修改文件，不自动 commit 和打 tag"
  echo "  --no-tag             自动 commit 但不打 tag"
  exit 1
}

# 解析第一个参数作为指令
if [ $# -gt 0 ]; then
  case "$1" in
    major|minor|patch)
      MODE="$1"
      shift
      ;;
    -t|--tag)
      MODE="tag"
      if [ $# -lt 2 ]; then
        echo "Error: -t/--tag 需要指定版本号"
        usage
      fi
      TARGET_VERSION="${2#v}"
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    *)
      echo "Error: 未知指令 '$1'"
      usage
      ;;
  esac
fi

# 解析剩余选项
while [ $# -gt 0 ]; do
  case "$1" in
    -t|--tag)
      MODE="tag"
      if [ $# -lt 2 ]; then
        echo "Error: -t/--tag 需要指定版本号"
        usage
      fi
      TARGET_VERSION="${2#v}"
      shift 2
      ;;
    --no-commit) DO_COMMIT=false; DO_TAG=false; shift ;;
    --no-tag)    DO_TAG=false; shift ;;
    -h|--help)   usage ;;
    *)
      echo "Error: 未知参数 '$1'"
      usage
      ;;
  esac
done

if [ -z "$MODE" ]; then
  echo "Error: 请指定版本升级指令或目标版本号"
  usage
fi

# ── 从 git tag 获取最高版本 ──────────────────────────────
get_latest_tag() {
  cd "$SCRIPT_DIR" || exit 1
  git tag -l 'v*' 2>/dev/null | sed 's/^v//' | sort -V | tail -n1
}

LATEST_TAG=$(get_latest_tag)

# ── 计算目标版本 ──────────────────────────────────────────
if [ "$MODE" = "tag" ]; then
  VERSION="$TARGET_VERSION"
  # 校验指定版本是否严格大于当前最新 tag（仅在有 tag 时校验）
  if [ -n "$LATEST_TAG" ]; then
    if [ "$VERSION" = "$LATEST_TAG" ]; then
      echo "Error: 指定版本 $VERSION 与当前最新 tag 相同，需要更高版本"
      exit 1
    fi
    HIGHER=$(printf '%s\n%s' "$VERSION" "$LATEST_TAG" | sort -V | tail -n1)
    if [ "$HIGHER" != "$VERSION" ]; then
      echo "Error: 指定版本 $VERSION 必须大于当前最新 tag $LATEST_TAG"
      exit 1
    fi
  fi
else
  if [ -z "$LATEST_TAG" ]; then
    echo "Error: 未找到任何 git tag（如 v4.5.0），无法计算 major/minor/patch"
    exit 1
  fi
  IFS='.' read -r MAJOR MINOR PATCH <<< "$LATEST_TAG"
  case "$MODE" in
    major) VERSION="$((MAJOR + 1)).0.0" ;;
    minor) VERSION="${MAJOR}.$((MINOR + 1)).0" ;;
    patch) VERSION="${MAJOR}.${MINOR}.$((PATCH + 1))" ;;
  esac
fi

TAG="v$VERSION"

if [ -n "$LATEST_TAG" ]; then
  echo "Latest tag:    $LATEST_TAG"
fi
echo "Target version: $VERSION ($TAG)"
echo ""

# ── 批量更新 manifest ─────────────────────────────────────
UPDATED=0
SKIPPED=0

# ── 更新根项目版本 ───────────────────────────────────────
if [ ! -f "$PACKAGE_JSON" ]; then
  echo "Error: 未找到根 package.json"
  exit 1
fi

PACKAGE_VERSION_LINE_COUNT=$(grep -Ec '^[[:space:]]*"version"[[:space:]]*:' "$PACKAGE_JSON" || true)
if [ "$PACKAGE_VERSION_LINE_COUNT" -ne 1 ]; then
  echo "Error: package.json 必须包含且只能包含一个 version 字段"
  exit 1
fi

PACKAGE_VERSION=$(grep '^[[:space:]]*"version"[[:space:]]*:' "$PACKAGE_JSON" | sed -E 's/^[^:]*:[[:space:]]*"([^"]+)".*$/\1/')
if [ "$PACKAGE_VERSION" != "$VERSION" ]; then
  sed -i '' -E "s/^([[:space:]]*\"version\"[[:space:]]*:[[:space:]]*\")[^\"]+(\"[, ]*)$/\1${VERSION}\2/" "$PACKAGE_JSON"
  echo "  OK    package.json: $PACKAGE_VERSION → $VERSION"
else
  echo "  SAME  package.json ($PACKAGE_VERSION)"
fi

for dir in "$APPS_DIR"/*/; do
  app="$(basename "$dir")"
  manifest="$dir/manifest"

  if [ ! -f "$manifest" ]; then
    echo "  SKIP  $app (no manifest)"
    SKIPPED=$((SKIPPED + 1))
    continue
  fi

  OLD_VER=$(grep '^version' "$manifest" | sed 's/.*= *//')

  if [ "$OLD_VER" = "$VERSION" ]; then
    echo "  SAME  $app ($OLD_VER)"
    SKIPPED=$((SKIPPED + 1))
    continue
  fi

  sed -i '' "s/^version *= *.*/version               = $VERSION/" "$manifest"
  echo "  OK    $app: $OLD_VER → $VERSION"
  UPDATED=$((UPDATED + 1))
done

# ── 更新 README.md ────────────────────────────────────────
README="$SCRIPT_DIR/README.md"
if [ -f "$README" ]; then
  sed -i '' "s|releases/tag/[^)]*|releases/tag/${TAG}|g" "$README"
  sed -i '' "s|git tag v[0-9][0-9.]*|git tag ${TAG}|g" "$README"
  echo ""
  echo "  README.md: updated"
fi

echo ""
echo "Updated: $UPDATED, Skipped: $SKIPPED"

# ── Git commit & tag ──────────────────────────────────────
if [ "$DO_COMMIT" = true ]; then
  echo ""
  cd "$SCRIPT_DIR"
  git add package.json apps/*/manifest README.md

  if git diff --cached --quiet; then
    echo "No changes to commit."
  else
    git commit -m "chore: bump version to $TAG"
    echo "Committed: chore: bump version to $TAG"

    if [ "$DO_TAG" = true ]; then
      git tag "$TAG"
      echo "Tagged: $TAG"
      echo ""
      echo "Push when ready:"
      echo "  git push origin main && git push origin $TAG"
    fi
  fi
fi
