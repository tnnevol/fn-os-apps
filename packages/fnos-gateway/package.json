{
  "name": "@tnnevol/fnos-gateway",
  "displayName": "fnOS Gateway",
  "type": "module",
  "version": "5.4.0",
  "description": "Unified gateway proxy for fnOS apps. Bundles connect and http-proxy-middleware into a single ESM file for FPK distribution.",
  "author": "tnnevol",
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/tnnevol/fn-os-apps/tree/main/packages/fnos-gateway",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnnevol/fn-os-apps.git",
    "directory": "packages/fnos-gateway"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "README.md",
    "lib"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm run build:bridge && pnpm run build:node",
    "build:bridge": "tsdown --config tsdown.bridge.config.ts",
    "build:node": "tsdown",
    "build:app": "pnpm run build:bridge && tsdown --config tsdown.app.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm run typecheck && pnpm run test",
    "test": "vitest run --config vitest.config.ts",
    "pretest": "pnpm run build:bridge"
  },
  "dependencies": {
    "commander": "catalog:",
    "connect": "catalog:",
    "http-proxy-middleware": "catalog:"
  },
  "devDependencies": {
    "@types/connect": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
