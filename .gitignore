# fnOS 打包产物
*.fpk

# Claude Code 配置
.claude/
.agents/

# OS 临时文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器/IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# 日志文件
*.log

# 环境变量文件（可能包含密钥）
.env
.env.*

# 临时脚本
tmp/
.qwen
.qoder

# Node.js 依赖
node_modules/

# Node.js 构建产物
lib/

# Turbo 本地缓存
.turbo/

# VitePress 构建产物
docs/.vitepress/cache/
docs/.vitepress/.temp/
docs/.vitepress/dist/

# 运行时状态（含凭据），不属于本仓库；只忽略仓库根目录的同名目录，
# 避免误伤 apps/<app>/app/seed/data/ 这类随包种子配置（它对应 TRIM_PKGVAR 下的相对路径）
/data/

# 本地 DSH_HOME 残留（profile、凭据、会话）；含密钥，绝不入库
.dsh/

.pnpm-store
.batch/
