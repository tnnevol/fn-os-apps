{
  "name": "@tnnevol/dsh-fnos",
  "displayName": "fnos",
  "description": "fnOS-specific integrations for DeepSeek Harness.",
  "version": "0.1.2-rc.1.1",
  "author": "tnnevol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnnevol/fn-os-apps.git",
    "directory": "plugins/dsh-fnos-plugin"
  },
  "homepage": "https://github.com/tnnevol/fn-os-apps/tree/main/plugins/dsh-fnos-plugin",
  "documentation": "https://fnapps-doc.tnnevol.cn/plugins/dsh-fnos",
  "bugs": {
    "url": "https://github.com/tnnevol/fn-os-apps/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./compatibility.json": "./compatibility.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "compatibility.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @tnnevol/dsh-semi-ui run build",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test": "pnpm run test:unit",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test:unit",
    "prepublishOnly": "pnpm run check",
    "publish:rc": "pnpm publish --tag rc --access public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-session-log-export",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:dsh",
    "@deepseek-ai/dsh-client-locale": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-session-log-export": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-input-trigger": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-sidebar": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-theme": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-workspace": "catalog:dsh",
    "@deepseek-ai/dsh-host-webserver": "catalog:dsh",
    "@deepseek-ai/dsh-settings": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@tnnevol/dsh-semi-ui": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:dsh",
    "@deepseek-ai/dsh-client-locale": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-session-log-export": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-input-trigger": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-sidebar": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-theme": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-workspace": "catalog:dsh",
    "@deepseek-ai/dsh-host-webserver": "catalog:dsh",
    "@deepseek-ai/dsh-settings": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:",
    "@trimjs/web-app": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}