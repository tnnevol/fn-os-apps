{
  "name": "@tnnevol/dsh-semi-ui-showcase",
  "displayName": "DSH Semi UI Showcase",
  "description": "Component showcase for the shared DSH-themed Semi Design package.",
  "version": "0.1.2-alpha.1",
  "author": "tnnevol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnnevol/fn-os-apps.git",
    "directory": "plugins/dsh-semi-ui-showcase-plugin"
  },
  "homepage": "https://github.com/tnnevol/fn-os-apps/tree/main/plugins/dsh-semi-ui-showcase-plugin",
  "documentation": "https://fnapps-doc.tnnevol.cn/plugins/dsh-semi-ui-showcase",
  "publishConfig": { "access": "public" },
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./compatibility.json": "./compatibility.json",
    "./package.json": "./package.json"
  },
  "files": ["lib", "compatibility.json", "cordis.patch.yml", "README.md"],
  "scripts": {
    "pretypecheck": "pnpm --filter @tnnevol/dsh-semi-ui run build",
    "prebuild": "pnpm --filter @tnnevol/dsh-semi-ui run build",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test",
    "publish:alpha": "npm publish --tag alpha --access public",
    "prepublishOnly": "pnpm run check"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@douyinfe/semi-icons": "2.90.2",
    "@douyinfe/semi-ui": "2.90.2",
    "@tnnevol/dsh-semi-ui": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
