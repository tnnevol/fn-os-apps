{
  "name": "@tnnevol/dsh-semi-ui-showcase",
  "displayName": "DSH Semi UI Showcase",
  "description": "Component showcase for the shared DSH-themed Semi Design package.",
  "version": "0.1.2-alpha.4",
  "author": "tnnevol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnnevol/fn-os-apps.git",
    "directory": "plugins/dsh-semi-ui-showcase-plugin"
  },
  "homepage": "https://github.com/tnnevol/fn-os-apps/tree/main/plugins/dsh-semi-ui-showcase-plugin",
  "documentation": "https://fnapps-doc.tnnevol.cn/plugins/dsh-semi-ui-showcase",
  "publishConfig": { "access": "public" },
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./compatibility.json": "./compatibility.json",
    "./package.json": "./package.json"
  },
  "files": ["lib", "compatibility.json", "cordis.patch.yml", "README.md"],
  "scripts": {
    "pretypecheck": "pnpm --filter @tnnevol/dsh-semi-ui run build",
    "prebuild": "pnpm --filter @tnnevol/dsh-semi-ui run build",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test": "pnpm run test:unit",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test:unit",
    "publish:rc": "pnpm publish --tag rc --access public",
    "prepublishOnly": "pnpm run check"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-theme": "catalog:dsh",
    "react": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-theme": "catalog:dsh",
    "@tnnevol/dsh-semi-ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
